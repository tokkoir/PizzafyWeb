@functions {
    private string GetProductDescription(string itemName)
    {
        var descriptions = new Dictionary<string, string>
        {
            {"Hawaiian", "Ham & Pineapple"},
            {"Meat Lovers", "Pepperoni, sausage, bacon, ham and cheese"},
            {"BBQ Chicken", "Spicy barbecue sauce, diced chicken, peppers, onion, and cilantro"},
            {"Spinach & Feta", "Red onion, spinach, feta cheese and mushrooms"},
            {"Margherita", "Fresh mozzarella, tomatoes, and basil"},
            {"Pepperoni", "Classic pepperoni with mozzarella cheese"},
            {"Veggie Supreme", "Bell peppers, mushrooms, onions, olives, and tomatoes"},
            {"Four Cheese", "Mozzarella, cheddar, parmesan, and provolone"},
            {"Chicken Wings", "Crispy chicken wings with your choice of sauce"},
            {"Garlic Bread", "Fresh baked bread with garlic butter"},
            {"Caesar Salad", "Fresh romaine lettuce with caesar dressing"},
            {"Coca Cola", "Classic refreshing cola drink"},
            {"Sprite", "Lemon-lime flavored soft drink"},
            {"Orange Juice", "Fresh squeezed orange juice"}
        };
        
        return descriptions.ContainsKey(itemName) ? descriptions[itemName] : "Delicious item made with fresh ingredients";
    }
}

@section Scripts {
    <script>
        let currentCategory = 'all';
        let currentPage = 1;
        let currentSearch = '';

        // Category switching with AJAX
        document.querySelectorAll('.category-btn').forEach(button => {
            button.addEventListener('click', async function() {
                document.querySelectorAll('.category-btn').forEach(btn => {
                    btn.classList.remove('active');
                    btn.style.transform = 'scale(1)';
                    btn.style.boxShadow = '0 6px 20px rgba(140,16,7,0.4)';
                });
                this.classList.add('active');
                this.style.transform = 'scale(1.1)';
                this.style.boxShadow = '0 8px 25px rgba(140,16,7,0.6)';

                currentCategory = this.dataset.category;
                currentPage = 1;

                const pageTitle = document.querySelector('h2');
                pageTitle.textContent = currentCategory === 'all' ? 'MENU' : `${currentCategory.toUpperCase()} MENU`;

                await loadProducts();
            });
        });

        // Search functionality
        let searchTimeout;
        const searchInputEl = document.getElementById('searchInput');
        if (searchInputEl) {
            searchInputEl.addEventListener('input', function() {
                clearTimeout(searchTimeout);
                currentSearch = this.value.toLowerCase();
                searchTimeout = setTimeout(async () => {
                    currentPage = 1;
                    await loadProducts();
                }, 500);
            });
        }

        // Load products via AJAX
        async function loadProducts() {
            const container = document.getElementById('product-container');
            const loading = document.getElementById('loadingIndicator');
            const paginationContainer = document.getElementById('pagination-container');

            loading.style.display = 'block';
            container.style.opacity = '0.5';

            try {
                const url = `/?handler=ProductsByCategory&category=${encodeURIComponent(currentCategory)}&search=${encodeURIComponent(currentSearch)}&page=${currentPage}`;
                const response = await fetch(url);
                if (!response.ok) throw new Error(`HTTP error ${response.status}`);
                const data = await response.json();

                container.innerHTML = '';

                if (!data.products || data.products.length === 0) {
                    container.innerHTML = `
                        <div class="col-12 text-center">
                            <div style="color:#8c1007;font-size:1.5rem;margin:3rem 0;">
                                <i class="fas fa-search" style="font-size:3rem;margin-bottom:1rem;"></i>
                                <p>No products found${currentSearch ? ` for "${currentSearch}"` : ''}</p>
                            </div>
                        </div>`;
                    paginationContainer.style.display = 'none';
                } else {
                    data.products.forEach(product => {
                        const productCard = createProductCard(product);
                        container.appendChild(productCard);
                    });
                    updatePagination(data.totalPages, data.currentPage, data.showPagination);
                }

                initializeCardEvents();
            } catch (e) {
                console.error(e);
                container.innerHTML = `
                    <div class="col-12 text-center">
                        <div style="color:#8c1007;font-size:1.5rem;margin:3rem 0;">
                            <i class="fas fa-exclamation-triangle" style="font-size:3rem;margin-bottom:1rem;"></i>
                            <p>Error loading products. Please try again.</p>
                        </div>
                    </div>`;
                document.getElementById('pagination-container').style.display = 'none';
            } finally {
                loading.style.display = 'none';
                container.style.opacity = '1';
            }
        }

        // Update pagination
        function updatePagination(totalPages, currentPageNum, showPagination) {
            const paginationContainer = document.getElementById('pagination-container');
            const paginationList = document.getElementById('pagination-list');

            currentPage = currentPageNum;

            if (currentCategory === 'all' || !showPagination || totalPages <= 1) {
                paginationContainer.style.display = 'none';
                return;
            }

            paginationContainer.style.display = 'block';
            paginationList.innerHTML = '';

            // Prev
            const prevLi = document.createElement('li');
            prevLi.className = `page-item ${currentPageNum === 1 ? 'disabled' : ''}`;
            prevLi.innerHTML = `<a class="page-link pagination-btn" href="#">&lt;</a>`;
            if (currentPageNum > 1) prevLi.querySelector('a').addEventListener('click', async e => { e.preventDefault(); currentPage = currentPageNum - 1; await loadProducts(); });
            paginationList.appendChild(prevLi);

            // Pages
            for (let i = 1; i <= totalPages; i++) {
                const li = document.createElement('li');
                li.className = `page-item ${i === currentPageNum ? 'active' : ''}`;
                li.innerHTML = `<a class="page-link pagination-btn" href="#">${i}</a>`;
                if (i !== currentPageNum) li.querySelector('a').addEventListener('click', async e => { e.preventDefault(); currentPage = i; await loadProducts(); });
                paginationList.appendChild(li);
            }

            // Next
            const nextLi = document.createElement('li');
            nextLi.className = `page-item ${currentPageNum === totalPages ? 'disabled' : ''}`;
            nextLi.innerHTML = `<a class="page-link pagination-btn" href="#">&gt;</a>`;
            if (currentPageNum < totalPages) nextLi.querySelector('a').addEventListener('click', async e => { e.preventDefault(); currentPage = currentPageNum + 1; await loadProducts(); });
            paginationList.appendChild(nextLi);
        }

        // Create product card element (unique product, size dropdown, dynamic price)
        function createProductCard(product) {
            const col = document.createElement('div');
            col.className = 'col-xl-3 col-lg-4 col-md-6 mb-4';

            const isDisabled = product.isAvailable === false || product.isAvailable === 'false' || product.isAvailable === 0;

            const imageHtml = product.image
                ? `<img src="/images/products/${product.image}" alt="${product.itemName}" style="width:160px;height:160px;border-radius:50%;object-fit:cover;margin:0 auto;display:block;background:transparent;" />`
                : `<div style="width:160px;height:160px;border-radius:50%;background:transparent;margin:0 auto;"></div>`;

            const sizesHtml = (product.sizes || []).map(size =>
                `<option value="${size.sizeId}" data-price="${size.price}" data-price-id="${size.priceId}">${size.sizeName}</option>`
            ).join('');

            // Use lighter background and dark text for disabled cards so overlay is visible
            const cardBg = isDisabled ? '#fffbe6' : '#8c1007';
            const textColor = isDisabled ? '#8c1007' : 'white';
            const priceColor = isDisabled ? '#8c1007' : '#FFD700';

            col.innerHTML = `
                <div class="product-card ${isDisabled ? 'disabled' : ''}" data-name="${(product.itemName || '').toLowerCase()}" style="background:${cardBg};border-radius:20px;color:${textColor};padding:1.5rem 1rem;text-align:center;box-shadow:0 8px 25px rgba(140,16,7,0.4);height:100%;transition:all 0.3s ease;position:relative;overflow:hidden;">
                    <div class="not-available-overlay" style="position:absolute;inset:0;background:rgba(255,255,255,0.85);display:${isDisabled ? 'flex' : 'none'};align-items:center;justify-content:center;z-index:3;font-weight:900;color:#8c1007;text-transform:uppercase;letter-spacing:1px;font-size:1.5rem;">
                        Not Available
                    </div>
                    <div class="product-image mb-2" style="position:relative;z-index:2;">${imageHtml}</div>
                    <h4 style="font-weight:800;font-size:1.3rem;margin-bottom:0.5rem;color:${textColor};position:relative;z-index:2;">${product.itemName}</h4>
                    <p style="color:${isDisabled ? '#8c1007' : '#FFF8DC'};font-size:0.9rem;line-height:1.3;margin-bottom:1rem;min-height:2.5rem;position:relative;z-index:2;font-weight:400;">${(product.description && product.description.length ? product.description : getProductDescription(product.itemName))}</p>
                    <div class="product-price" style="font-size:1.8rem;font-weight:900;margin-bottom:1rem;color:${priceColor};text-shadow:2px 2px 4px rgba(0,0,0,0.3);position:relative;z-index:2;">&#8369;${Number(product.price).toFixed(2)}</div>
                    <div class="product-controls" style="position:relative;z-index:2;">
                        <div class="controls-row" style="display:grid;grid-template-columns:50px 1fr 50px;gap:5px;align-items:end;max-width:360px;margin:0 auto;">
                            <div class="control-group" style="text-align:left;">
                                <label style="font-weight:700;font-size:0.75rem;color:#FFD700;display:block;margin-bottom:2px;">QTY</label>
                                <select class="form-select qty-select" style="width:50px;height:44px;border-radius:8px;font-weight:600;text-align:center;font-size:0.85rem;padding:0 4px;margin:0;" ${isDisabled ? 'disabled' : ''}>
                                    ${Array.from({ length: 10 }, (_, i) => `<option value="${i + 1}">${i + 1}</option>`).join('')}
                                </select>
                            </div>
                            <div class="control-group" style="text-align:center;">
                                <label style="font-weight:700;font-size:0.75rem;color:#FFD700;display:block;margin-bottom:2px;">SIZE</label>
                                <select class="form-select size-select" style="width:100%;height:44px;border-radius:8px;font-weight:600;text-align:center;font-size:0.8rem;padding:0 10px;margin:0;" ${isDisabled ? 'disabled' : ''}>
                                    ${sizesHtml}
                                </select>
                            </div>
                            <button class="add-to-cart-btn" style="background:#FFF8DC;color:#8c1007;border:none;border-radius:12px;width:50px;height:44px;font-size:1.1rem;transition:all 0.3s ease;box-shadow:0 3px 10px rgba(0,0,0,0.2);font-weight:800;display:flex;align-items:center;justify-content:center;" data-product-id="${product.menuItemId}" ${isDisabled ? 'disabled' : ''}>
                                <i class="fas fa-shopping-cart"></i>
                            </button>
                        </div>
                    </div>
                </div>`;

            // Set/change price on size change
            const sizeSelect = col.querySelector('.size-select');
            const priceDisplay = col.querySelector('.product-price');
            if (sizeSelect && priceDisplay) {
                const apply = () => {
                    const opt = sizeSelect.options[sizeSelect.selectedIndex];
                    const p = parseFloat(opt.dataset.price);
                    if (!isNaN(p)) priceDisplay.textContent = `\u20B1${p.toFixed(2)}`; // use Unicode peso sign
                };
                sizeSelect.addEventListener('change', apply);
                // initialize to first size price
                apply();
            }

            return col;
        }

        function getProductDescription(itemName) {
            const descriptions = {
                "hawaiian": "Ham & Pineapple",
                "meat lovers": "Pepperoni, sausage, bacon, ham and cheese",
                "bbq chicken": "Spicy barbecue sauce, diced chicken, peppers, onion, and cilantro",
                "spinach & feta": "Red onion, spinach, feta cheese and mushrooms",
                "margherita": "Fresh mozzarella, tomatoes, and basil",
                "pepperoni": "Classic pepperoni with mozzarella cheese",
                "veggie supreme": "Bell peppers, mushrooms, onions, olives, and tomatoes",
                "four cheese": "Mozzarella, cheddar, parmesan, and provolone",
                "chicken wings": "Crispy chicken wings with your choice of sauce",
                "garlic bread": "Fresh baked bread with garlic butter",
                "caesar salad": "Fresh romaine lettuce with caesar dressing",
                "coca cola": "Classic refreshing cola drink",
                "sprite": "Lemon-lime flavored soft drink",
                "orange juice": "Fresh squeezed orange juice"
            };

            if (!itemName) return "Delicious item made with fresh ingredients";

            // Normalize: lowercase and remove common suffix like "pizza"
            const normalized = itemName.toLowerCase().replace(/\bpizza\b/g, '').trim();

            // Direct lookup
            if (descriptions[normalized]) return descriptions[normalized];

            // Try prefix match (for names like "pepperoni pizza")
            for (const key in descriptions) {
                if (normalized.includes(key)) return descriptions[key];
            }

            // Fallback
            return "Delicious item made with fresh ingredients";
        }

        async function addToCart(button) {
            const card = button.closest('.product-card');
            const qty = parseInt(card.querySelector('.qty-select').value);
            const sizeSelect = card.querySelector('.size-select');
            const selected = sizeSelect.options[sizeSelect.selectedIndex];
            const priceId = selected.getAttribute('data-price-id');
            if (!priceId) {
                console.warn('Missing price id on size option');
                return;
            }
            button.disabled = true;
            const icon = button.innerHTML;
            button.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            try {
                const res = await fetch('/Cart?handler=Add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ priceId: parseInt(priceId), quantity: qty })
                });
                if (res.status === 401) {
                    window.location.href = '/Login';
                    return;
                }
                const data = await res.json();
                if (!data.ok) throw new Error(data.message || 'Failed');
                button.innerHTML = '<i class="fas fa-check"></i>';
                button.style.background = '#28a745';
                setTimeout(() => { button.innerHTML = icon; button.style.background = '#FFF8DC'; }, 800);
                if (window.onAddedToCart) window.onAddedToCart();
            } catch (err) {
                console.error(err);
                button.innerHTML = '<i class="fas fa-times"></i>';
                button.style.background = '#dc3545';
                setTimeout(() => { button.innerHTML = icon; button.style.background = '#FFF8DC'; }, 1500);
            } finally {
                button.disabled = false;
            }
        }

        function initializeCardEvents() {
            // attach handlers to active buttons only
            document.querySelectorAll('.add-to-cart-btn').forEach(button => {
                try {
                    if (button.disabled) return; // do not attach to disabled cards
                    // remove previous handlers by cloning node
                    const cloned = button.cloneNode(true);
                    button.parentNode.replaceChild(cloned, button);
                } catch { }
            });

            document.querySelectorAll('.add-to-cart-btn').forEach(button => {
                if (button.disabled) return;
                button.addEventListener('click', function() {
                    addToCart(this);
                });
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            const allButton = document.querySelector('[data-category="all"]');
            if (allButton) {
                allButton.classList.add('active');
                allButton.style.transform = 'scale(1.1)';
                allButton.style.boxShadow = '0 8px 25px rgba(140,16,7,0.6)';
            }
            const paginationContainer = document.getElementById('pagination-container');
            if (paginationContainer) paginationContainer.style.display = 'none';
            initializeCardEvents();
        });
    </script>
}
