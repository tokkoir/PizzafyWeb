@model List<PizzafyWeb.Pages.PizzaProductViewModel>

@foreach (var product in Model)
{
    <div class="col-xl-3 col-lg-4 col-md-6 mb-4">
        <div class="product-card" style="background:#8c1007;border-radius:20px;color:white;padding:1.5rem 1rem;text-align:center;box-shadow:0 8px 25px rgba(140,16,7,0.4);height:100%;transition:all 0.3s ease;position:relative;overflow:hidden;">
            <!-- Decorative elements -->
            <div style="position:absolute;top:-30px;right:-30px;width:60px;height:60px;background:rgba(255,248,220,0.1);border-radius:50%;"></div>
            <div style="position:absolute;bottom:-20px;left:-20px;width:40px;height:40px;background:rgba(255,248,220,0.1);border-radius:50%;"></div>
            
            <!-- Product Image -->
            <div class="product-image mb-2" style="position:relative;z-index:2;">
                @if (!string.IsNullOrEmpty(product.Image))
                {
                    <img src="/images/products/@product.Image" alt="@product.ItemName" style="width:160px;height:160px;border-radius:50%;object-fit:cover;margin:0 auto;display:block;background:transparent;" />
                }
                else
                {
                    <div style="width:160px;height:160px;border-radius:50%;background:transparent;margin:0 auto;"></div>
                }
            </div>
            
            <!-- Product Name -->
            <h4 style="font-weight:800;font-size:1.3rem;margin-bottom:0.5rem;color:white;position:relative;z-index:2;">@product.ItemName</h4>
            
            <!-- Product Description -->
            <p style="color:#FFF8DC;font-size:0.9rem;line-height:1.3;margin-bottom:1rem;min-height:2.5rem;position:relative;z-index:2;font-weight:400;">
                @GetProductDescription(product.ItemName)
            </p>
            
            <!-- Price -->
            <div class="product-price" style="font-size:1.8rem;font-weight:900;margin-bottom:1rem;color:#FFD700;text-shadow:2px 2px 4px rgba(0,0,0,0.3);position:relative;z-index:2;">
                &#8369;@product.Price.ToString("0.00")
            </div>
            
            <!-- Controls -->
            <div class="product-controls" style="position:relative;z-index:2;">
                <div class="controls-row" style="display:grid;grid-template-columns:80px 1fr 50px;gap:10px;align-items:end;max-width:360px;margin:0 auto;">
                    <div class="control-group" style="text-align:left;">
                        <label style="font-weight:700;font-size:0.8rem;color:#FFD700;display:block;margin-bottom:4px;">QTY</label>
                        <select class="form-select qty-select" style="width:100%;height:40px;border-radius:8px;border:2px solid #FFF8DC;font-weight:600;text-align:center;font-size:0.85rem;">
                            @for (int q = 1; q <= 10; q++)
                            {
                                <option value="@q">@q</option>
                            }
                        </select>
                    </div>
                    <div class="control-group" style="text-align:left;">
                        <label style="font-weight:700;font-size:0.8rem;color:#FFD700;display:block;margin-bottom:4px;">SIZE</label>
                        <select class="form-select size-select" style="width:100%;height:40px;border-radius:8px;border:2px solid #FFF8DC;font-weight:600;text-align:center;font-size:0.8rem;">
                            @foreach (var size in product.Sizes)
                            {
                                <option value="@size.SizeId" data-price="@size.Price">@size.SizeName - &#8369;@size.Price.ToString("0.00")</option>
                            }
                        </select>
                    </div>
                    <button class="add-to-cart-btn" style="background:#FFF8DC;color:#8c1007;border:none;border-radius:12px;width:50px;height:50px;font-size:1.1rem;transition:all 0.3s ease;box-shadow:0 3px 10px rgba(0,0,0,0.2);font-weight:800;display:flex;align-items:center;justify-content:center;" data-product-id="@product.MenuItemId">
                        <i class="fas fa-shopping-cart"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<script>
    document.querySelectorAll('.product-card .size-select').forEach(sel => {
        const priceEl = sel.closest('.product-card').querySelector('.product-price');
        const apply = () => {
            const opt = sel.options[sel.selectedIndex];
            const p = parseFloat(opt.dataset.price);
            if (!isNaN(p)) priceEl.textContent = `\u20B1${p.toFixed(2)}`;
        };
        sel.addEventListener('change', apply);
        apply();
    });
</script>

@functions {
    private string GetProductDescription(string itemName)
    {
        var descriptions = new Dictionary<string, string>
        {
            {"Hawaiian", "Ham & Pineapple"},
            {"Meat Lovers", "Pepperoni, sausage, bacon, ham and cheese"},
            {"BBQ Chicken", "Spicy barbecue sauce, diced chicken, peppers, onion, and cilantro"},
            {"Spinach & Feta", "Red onion, spinach, feta cheese and mushrooms"},
            {"Margherita", "Fresh mozzarella, tomatoes, and basil"},
            {"Pepperoni", "Classic pepperoni with mozzarella cheese"},
            {"Veggie Supreme", "Bell peppers, mushrooms, onions, olives, and tomatoes"},
            {"Four Cheese", "Mozzarella, cheddar, parmesan, and provolone"},
            {"Chicken Wings", "Crispy chicken wings with your choice of sauce"},
            {"Garlic Bread", "Fresh baked bread with garlic butter"},
            {"Caesar Salad", "Fresh romaine lettuce with caesar dressing"},
            {"Coca Cola", "Classic refreshing cola drink"},
            {"Sprite", "Lemon-lime flavored soft drink"},
            {"Orange Juice", "Fresh squeezed orange juice"}
        };
        
        return descriptions.ContainsKey(itemName) ? descriptions[itemName] : "Delicious item made with fresh ingredients";
    }
}