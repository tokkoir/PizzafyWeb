@page
@model PizzafyWeb.Pages.Admin.AddProductModel
@using PizzafyWeb.Models
@{
    ViewData["Title"] = "Add Product - Admin";
    Layout = "_AdminLayout";
}

<div class="admin-content">
    <!-- Header Section -->
    <div class="admin-header">
        <h1 class="page-title">Add New Product</h1>
    </div>

    <!-- Add Product Form -->
    <div class="add-product-container">
        <div class="row">
            <div class="col-lg-8">
                <div class="product-form-card">
                    <form method="post" enctype="multipart/form-data">
                        <!-- Product Basic Info -->
                        <div class="form-section">
                            <div class="table-header-style">
                                <h3 class="section-title">Product Information</h3>
                            </div>
                            <div class="form-content">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="ProductName" class="form-label">Product Name *</label>
                                            <input asp-for="ProductName" class="form-control" placeholder="Enter product name" id="productNameInput" />
                                            <span asp-validation-for="ProductName" class="text-danger"></span>
                                        </div>
                                    </div>
                                    
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="CategoryId" class="form-label">Category *</label>
                                            <select asp-for="CategoryId" class="form-select" id="categorySelect">
                                                <option value="0">Select a category</option>
                                                @foreach (var category in Model.Categories.OrderBy(c => c.CategoryName.ToLower() == "pizza" ? 0 : c.CategoryName.ToLower() == "sides" ? 1 : c.CategoryName.ToLower() == "beverages" ? 2 : 100).ThenBy(c => c.CategoryName))
                                                {
                                                    <option value="@category.CategoryId" data-category-name="@category.CategoryName">@category.CategoryName</option>
                                                }
                                            </select>
                                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <input type="hidden" asp-for="ExistingImageName" id="existingImageName" />

                                <div class="form-group">
                                    <label asp-for="ImageFile" class="form-label">Product Image</label>
                                    <div class="image-upload-container">
                                        <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" id="imageInput" />
                                        <div class="image-preview" id="imagePreview">
                                            <i class="fas fa-image"></i>
                                            <span>No image selected</span>
                                        </div>
                                    </div>
                                    <span asp-validation-for="ImageFile" class="text-danger"></span>
                                    <small class="form-text text-muted">Supported formats: JPG, PNG, GIF (Max: 5MB)</small>
                                </div>

                                <div class="form-group">
                                    <label asp-for="Description" class="form-label">Description</label>
                                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter product description" maxlength="500"></textarea>
                                    <span asp-validation-for="Description" class="text-danger"></span>
                                    <small class="form-text text-muted">Maximum 500 characters</small>
                                </div>
                            </div>
                        </div>

                        <!-- Pricing Section -->
                        <div class="form-section">
                            <div class="table-header-style">
                                <h3 class="section-title">Size & Price</h3>
                            </div>
                            <div class="form-content">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="SelectedSizeId" class="form-label">Size *</label>
                                            <select asp-for="SelectedSizeId" class="form-select" id="sizeSelect">
                                                <option value="">Select a size</option>
                                                @foreach (var size in Model.AvailableSizes.OrderBy(s => s.SizeName))
                                                {
                                                    <option value="@size.SizeId">@size.SizeName</option>
                                                }
                                            </select>
                                            <span asp-validation-for="SelectedSizeId" class="text-danger"></span>
                                        </div>
                                    </div>
                                    
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="Price" class="form-label">Price *</label>
                                            <div class="input-group">
                                                <span class="input-group-text">P</span>
                                                <input asp-for="Price" type="number" step="0.01" min="0" 
                                                       class="form-control" placeholder="0.00" />
                                            </div>
                                            <span asp-validation-for="Price" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Form Actions -->
                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-plus me-2"></i>Add Product
                            </button>
                            <a href="/Admin/MenuManagement" class="btn btn-secondary">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Preview Panel -->
            <div class="col-lg-4">
                <div class="preview-card">
                    <h3 class="preview-title">Product Preview</h3>
                    <div class="product-preview">
                        <div class="preview-image" id="previewImage">
                            <i class="fas fa-image"></i>
                            <span>No image</span>
                        </div>
                        <div class="preview-info">
                            <h4 class="preview-name" id="previewName">Product Name</h4>
                            <p class="preview-description" id="previewDescription">No description</p>
                            <span class="preview-category" id="previewCategory">Category</span>
                            <div class="preview-price" id="previewPrices">
                                <span class="no-price">No price set</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // JS size sort key to mirror server sorting
        function getSizeSortKey(label) {
            const s = (label || '').trim().toLowerCase();
            if (s.includes('extra small') || s === 'xs' || s.includes('x-small')) return 0;
            if (s.includes('small')) return 1;
            if (s.includes('medium') || s === 'md') return 2;
            if (s === 'large') return 3;
            if (s.includes('x-large') || s.includes('extra large') || s === 'xl') return 4;
            if (s.includes('xx-large') || s.includes('2x') || s === 'xxl') return 5;
            const m = s.match(/(\d+\.?\d*)\s*(in|inch|inches|cm|mm|oz)/);
            if (m) return 100 + Math.round(parseFloat(m[1]) * 10);
            const m2 = s.match(/^(\d+)$/);
            if (m2) return 100 + parseInt(m2[1]);
            return 1000;
        }

        // Image preview functionality
        document.getElementById('imageInput').addEventListener('change', function(e) {
            const file = e.target.files[0];
            const preview = document.getElementById('imagePreview');
            const previewImage = document.getElementById('previewImage');
            
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.innerHTML = `<img src="${e.target.result}" alt="Preview" />`;
                    previewImage.innerHTML = `<img src="${e.target.result}" alt="Preview" />`;
                }
                reader.readAsDataURL(file);
            } else {
                preview.innerHTML = '<i class="fas fa-image"></i><span>No image selected</span>';
                previewImage.innerHTML = '<i class="fas fa-image"></i><span>No image</span>';
            }
        });

        // Real-time preview updates
        document.querySelector('input[name="ProductName"]').addEventListener('input', function() {
            document.getElementById('previewName').textContent = this.value || 'Product Name';
        });

        // Description preview update
        document.querySelector('textarea[name="Description"]').addEventListener('input', function() {
            document.getElementById('previewDescription').textContent = this.value || 'No description';
        });

        // Category change handler - simplified
        document.querySelector('select[name="CategoryId"]').addEventListener('change', async function() {
            const selectedOption = this.options[this.selectedIndex];
            const categoryName = selectedOption.getAttribute('data-category-name') || selectedOption.text;
            const categoryId = this.value;
            
            // Update preview category
            document.getElementById('previewCategory').textContent = categoryName || 'Category';
            
            // Only update preview image if there's an uploaded image
            // Don't show category defaults in preview
            const imageInput = document.getElementById('imageInput');
            if (!imageInput.files.length) {
                const previewImage = document.getElementById('previewImage');
                previewImage.innerHTML = '<i class="fas fa-image"></i><span>No image</span>';
            }
            
            // Load sizes for the selected category
            if (categoryId && categoryId !== '0') {
                await loadSizesForCategory(categoryId);
            } else {
                // Clear sizes if no category selected
                const sizeSelect = document.getElementById('sizeSelect');
                sizeSelect.innerHTML = '<option value="">Select a size</option>';
            }
            
            // Update preview
            updatePreview();
        });

        // Load sizes for category via AJAX
        async function loadSizesForCategory(categoryId) {
            try {
                const response = await fetch(`/Admin/AddProduct?handler=Sizes&categoryId=${categoryId}`);
                let sizes = await response.json();
                // Ensure sizes are ordered Small -> Medium -> Large -> XL and numerics ascending
                sizes = sizes.sort((a, b) => {
                    const ak = getSizeSortKey(a.sizeName);
                    const bk = getSizeSortKey(b.sizeName);
                    if (ak !== bk) return ak - bk;
                    return a.sizeName.localeCompare(b.sizeName);
                });
                
                const sizeSelect = document.getElementById('sizeSelect');
                sizeSelect.innerHTML = '<option value="">Select a size</option>';
                
                sizes.forEach(size => {
                    const option = document.createElement('option');
                    option.value = size.sizeId;
                    option.textContent = size.sizeName;
                    sizeSelect.appendChild(option);
                });
            } catch (error) {
                console.error('Error loading sizes:', error);
                const sizeSelect = document.getElementById('sizeSelect');
                sizeSelect.innerHTML = '<option value="">Error loading sizes</option>';
            }
        }

        // Update price preview
        function updatePreview() {
            const previewPrices = document.getElementById('previewPrices');
            const sizeSelect = document.getElementById('sizeSelect');
            const priceInput = document.querySelector('input[name="Price"]');
            
            if (sizeSelect.value && priceInput.value && parseFloat(priceInput.value) > 0) {
                const selectedOption = sizeSelect.options[sizeSelect.selectedIndex];
                const sizeLabel = selectedOption.textContent;
                const price = parseFloat(priceInput.value).toFixed(2);
                previewPrices.innerHTML = `<div class="price-item-preview">${sizeLabel}: P${price}</div>`;
            } else {
                previewPrices.innerHTML = '<span class="no-prices">No price set</span>';
            }
        }

        // Add event listener to size dropdown
        document.getElementById('sizeSelect').addEventListener('change', updatePreview);

        // Add event listener to price input
        document.querySelector('input[name="Price"]').addEventListener('input', updatePreview);

        // Form validation
        document.querySelector('form').addEventListener('submit', function(e) {
            const sizeSelect = document.getElementById('sizeSelect');
            const priceInput = document.querySelector('input[name="Price"]');
            
            if (!sizeSelect.value) {
                e.preventDefault();
                alert('Please select a size.');
                return false;
            }
            
            if (!priceInput.value || parseFloat(priceInput.value) <= 0) {
                e.preventDefault();
                alert('Please enter a valid price.');
                return false;
            }
        });

        // Initialize on page load - simplified
        document.addEventListener('DOMContentLoaded', function() {
            const categorySelect = document.querySelector('select[name="CategoryId"]');
            if (categorySelect.value > 0) {
                // Only initialize preview without showing default images
                const previewImage = document.getElementById('previewImage');
                const imageInput = document.getElementById('imageInput');
                if (!imageInput.files.length) {
                    previewImage.innerHTML = '<i class="fas fa-image"></i><span>No image</span>';
                }
            }
            updatePreview();
        });

        // Client-side auto-fill for product name
        document.getElementById('productNameInput').addEventListener('input', async function() {
            const productName = this.value.trim();
            
            if (productName.length < 3) {
                // Clear fields if input is too short
                clearAutoFill();
                return;
            }
            
            try {
                const response = await fetch(`/Admin/AddProduct?handler=AutoFillProduct&name=${encodeURIComponent(productName)}`);
                const product = await response.json();
                
                if (product && product.productId) {
                    // Prefill fields with received data
                    document.getElementById('previewName').textContent = product.productName;
                    document.getElementById('previewDescription').textContent = product.description;
                    document.getElementById('previewCategory').textContent = product.categoryName;
                    
                    // Set ExistingImageName value
                    document.getElementById('existingImageName').value = product.imageFileName;
                    
                    // Update image preview if no new file is selected
                    const imageInput = document.getElementById('imageInput');
                    if (!imageInput.files.length) {
                        document.getElementById('previewImage').innerHTML = `<img src="/images/products/${product.imageFileName}" alt="Product Image" />`;
                    }
                    
                    // Prefill category and size if available
                    const categorySelect = document.getElementById('categorySelect');
                    categorySelect.value = product.categoryId;
                    await loadSizesForCategory(product.categoryId);
                    
                    const sizeSelect = document.getElementById('sizeSelect');
                    sizeSelect.value = product.selectedSizeId;
                    
                    // Prefill price
                    const priceInput = document.querySelector('input[name="Price"]');
                    priceInput.value = (product.price / 100).toFixed(2);
                    
                    // Update preview
                    updatePreview();
                } else {
                    // Clear fields if no product found
                    clearAutoFill();
                }
            } catch (error) {
                console.error('Error fetching product data:', error);
                clearAutoFill();
            }
        });

        function clearAutoFill() {
            document.getElementById('previewName').textContent = 'Product Name';
            document.getElementById('previewDescription').textContent = 'No description';
            document.getElementById('previewCategory').textContent = 'Category';
            document.getElementById('existingImageName').value = '';
            document.getElementById('previewImage').innerHTML = '<i class="fas fa-image"></i><span>No image</span>';
            updatePreview();
        }

        // Auto-fetch existing product info by name
        const nameInput = document.getElementById('productNameInput');
        let prefillLock = false;
        async function tryPrefillByName() {
            if (prefillLock) return;
            const name = (nameInput.value || '').trim();
            if (name.length < 2) return;
            try {
                const res = await fetch(`/Admin/AddProduct?handler=ProductInfo&name=${encodeURIComponent(name)}`);
                const data = await res.json();
                if (!data || !data.found) return;

                // Set category
                const catSel = document.getElementById('categorySelect');
                if (String(catSel.value) !== String(data.categoryId)) {
                    catSel.value = String(data.categoryId);
                    await loadSizesForCategory(String(data.categoryId));
                }
                document.getElementById('previewCategory').textContent = data.categoryName || 'Category';

                // Set description if empty or shorter
                const desc = document.querySelector('textarea[name="Description"]');
                if (!desc.value || desc.value.length < (data.description?.length || 0)) {
                    desc.value = data.description || '';
                    document.getElementById('previewDescription').textContent = desc.value || 'No description';
                }

                // If there's an existing image and no new upload yet, show it and keep filename in hidden field
                const existing = (data.image || '').trim();
                const imageInput = document.getElementById('imageInput');
                const previewImage = document.getElementById('previewImage');
                const existingHidden = document.getElementById('existingImageName');
                if (existing && !imageInput.files.length) {
                    existingHidden.value = existing;
                    const url = `/images/products/${existing}`;
                    document.getElementById('imagePreview').innerHTML = `<img src="${url}" alt="Existing" />`;
                    previewImage.innerHTML = `<img src="${url}" alt="Existing" />`;
                }
            } catch (e) {
                console.warn('prefill failed', e);
            }
        }

        function clearAllProductInfo() {
            // Reset selects and inputs
            const catSel = document.getElementById('categorySelect');
            if (catSel) catSel.value = '0';
            const sizeSelect = document.getElementById('sizeSelect');
            if (sizeSelect) sizeSelect.innerHTML = '<option value="">Select a size</option>';
            const priceInput = document.querySelector('input[name="Price"]');
            if (priceInput) priceInput.value = '';
            const desc = document.querySelector('textarea[name="Description"]');
            if (desc) desc.value = '';

            // Clear image inputs and hidden existing image
            const imageInput = document.getElementById('imageInput');
            if (imageInput) imageInput.value = '';
            const existingHidden = document.getElementById('existingImageName');
            if (existingHidden) existingHidden.value = '';

            // Reset previews
            const previewName = document.getElementById('previewName');
            if (previewName) previewName.textContent = 'Product Name';
            const previewDesc = document.getElementById('previewDescription');
            if (previewDesc) previewDesc.textContent = 'No description';
            const previewCat = document.getElementById('previewCategory');
            if (previewCat) previewCat.textContent = 'Category';
            const imgPrev = document.getElementById('imagePreview');
            if (imgPrev) imgPrev.innerHTML = '<i class="fas fa-image"></i><span>No image selected</span>';
            const previewImg = document.getElementById('previewImage');
            if (previewImg) previewImg.innerHTML = '<i class="fas fa-image"></i><span>No image</span>';
            const previewPrices = document.getElementById('previewPrices');
            if (previewPrices) previewPrices.innerHTML = '<span class="no-prices">No price set</span>';
        }

        nameInput.addEventListener('blur', tryPrefillByName);
        nameInput.addEventListener('change', () => { document.getElementById('existingImageName').value = ''; });
        nameInput.addEventListener('input', () => {
            const val = (nameInput.value || '').trim();
            if (val.length === 0) {
                clearAllProductInfo();
            }
        });
    </script>
}