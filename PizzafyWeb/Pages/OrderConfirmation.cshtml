@page
@model PizzafyWeb.Pages.OrderConfirmationModel
@{
    ViewData["Title"] = "Order Confirmation";
}

<section class="container py-4">
    <div class="position-relative text-center mb-4">
        <a href="/Orders" class="btn btn-outline-secondary position-absolute start-0 top-50 translate-middle-y">
            <i class="fas fa-arrow-left me-1"></i>Back
        </a>
        <h2 style="color:#8c1007;font-weight:900;letter-spacing:2px;">Order Confirmed</h2>
        <p class="text-muted">Thank you for your order! Below are your order details.</p>
    </div>

    @if (Model.Order != null)
    {
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">
                <!-- Order Information -->
                <div class="card mb-4">
                    <div class="card-header" style="background:#8c1007;color:white;">
                        <h5 class="mb-0"><i class="fas fa-receipt me-2"></i>Order Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <p class="mb-1"><strong>Order Number:</strong> #@Model.Order.OrderId</p>
                                <p class="mb-1"><strong>Status:</strong> @Model.Order.StatusName</p>
                                <p class="mb-0"><strong>Payment Method:</strong> @Model.Order.PaymentMethod</p>
                            </div>
                            <div class="col-md-6 text-md-end">
                                <p class="mb-1"><strong>Date:</strong> @PizzafyWeb.Utils.TimeUtils.FormatPH(Model.Order.OrderDate, "MMM dd, yyyy 'at' hh:mm tt")</p>
                                <p class="mb-0"><strong>Total:</strong> <span class="text-success">&#8369;@Model.Order.TotalAmount.ToString("0.00")</span></p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Customer -->
                <div class="card mb-4">
                    <div class="card-header" style="background:#8c1007;color:white;">
                        <h5 class="mb-0"><i class="fas fa-user me-2"></i>Customer</h5>
                    </div>
                    <div class="card-body">
                        <p class="mb-1"><strong>Name:</strong> @Model.Order.CustomerName</p>
                        <p class="mb-1"><strong>Phone:</strong> @Model.Order.PhoneNumber</p>
                        <p class="mb-0"><strong>Address:</strong> @Model.Order.Address</p>
                    </div>
                </div>

                <!-- Order Items -->
                <div class="card mb-4">
                    <div class="card-header" style="background:#8c1007;color:white;">
                        <h5 class="mb-0"><i class="fas fa-shopping-cart me-2"></i>Order Items</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Item</th>
                                        <th>Size</th>
                                        <th>Qty</th>
                                        <th>Unit Price</th>
                                        <th>Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Order.Items)
                                    {
                                        <tr>
                                            <td>@item.ItemName</td>
                                            <td>@item.SizeName</td>
                                            <td>@item.Quantity</td>
                                            <td>&#8369;@item.UnitPrice.ToString("0.00")</td>
                                            <td>&#8369;@item.Subtotal.ToString("0.00")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="4"><strong>Subtotal:</strong></td>
                                        <td><strong>&#8369;@Model.Order.Subtotal.ToString("0.00")</strong></td>
                                    </tr>
                                    <tr>
                                        <td colspan="4"><strong>Delivery Fee:</strong></td>
                                        <td><strong>&#8369;@Model.Order.DeliveryFee.ToString("0.00")</strong></td>
                                    </tr>
                                    <tr class="table-success">
                                        <td colspan="4"><strong>Total:</strong></td>
                                        <td><strong>&#8369;@Model.Order.TotalAmount.ToString("0.00")</strong></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Actions (below the brand/title) remain here top of page -->
                <div class="d-flex justify-content-center gap-2 mb-4">
                    <a href="/Orders?handler=DownloadReceipt&orderId=@Model.Order.OrderId" class="btn btn-success" download>
                        <i class="fas fa-download me-1"></i>Download Receipt
                    </a>
                </div>
            </div>
        </div>
    }
</section>

@section Scripts {
    <script>
        // Auto-refresh page every 30 seconds to update order status
        setTimeout(function() {
            location.reload();
        }, 30000);

        // Confetti animation on page load
        document.addEventListener('DOMContentLoaded', function() {
            // Simple celebration animation
            const checkIcon = document.querySelector('.fa-check');
            if (checkIcon) {
                checkIcon.style.animation = 'pulse 2s infinite';
            }
        });

        // Download receipt with better UX
        document.querySelector('a[download]')?.addEventListener('click', function(e) {
            const btn = this;
            const originalText = btn.innerHTML;
            
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Generating Receipt...';
            btn.classList.add('disabled');
            
            setTimeout(() => {
                btn.innerHTML = '<i class="fas fa-check me-2"></i>Receipt Downloaded!';
                btn.classList.remove('btn-outline-success');
                btn.classList.add('btn-success');
                
                setTimeout(() => {
                    btn.innerHTML = originalText;
                    btn.classList.remove('btn-success', 'disabled');
                    btn.classList.add('btn-outline-success');
                }, 2000);
            }, 1000);
        });
    </script>
}

@section Styles {
    <style>
        @@keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); }
        }
        
        .badge-pill {
            border-radius: 50px;
        }

        .btn.disabled {
            pointer-events: none;
            opacity: 0.6;
        }

        /* Print styles for the downloaded receipt */
        @@media print {
            .no-print {
                display: none !important;
            }
        }
    </style>
}