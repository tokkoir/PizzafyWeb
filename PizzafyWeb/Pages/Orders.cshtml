@page
@model PizzafyWeb.Pages.OrdersModel
@{
    ViewData["Title"] = "My Orders";
    ViewData["BodyClass"] = "orders-page";
}

<section class="container py-4">
    <!-- Header Section -->
    <div class="text-center mb-4">
        <h2 style="color:#8c1007;font-weight:900;letter-spacing:2px;margin-bottom:1rem;">
            <i class="fas fa-history me-2"></i>My Orders
        </h2>
        
        @if (Model.AllOrdersCount > 0)
        {
            <p class="text-muted mb-4" style="font-size:1.1rem;">
                You have placed <strong>@Model.AllOrdersCount</strong> order@(Model.AllOrdersCount != 1 ? "s" : "") with us
            </p>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.AllOrdersCount == 0)
    {
        <div class="text-center py-5">
            <div class="mb-4">
                <i class="fas fa-shopping-bag fa-4x text-muted mb-3"></i>
                <h4 class="text-muted">No orders yet</h4>
                <p class="text-muted">Start ordering your favorite pizza!</p>
            </div>
            <a href="/" class="btn btn-primary btn-lg">
                <i class="fas fa-plus me-2"></i>Start Ordering
            </a>
        </div>
    }
    else
    {
        <!-- Filter Tabs with Counts -->
        <div class="d-flex justify-content-center mb-5">
            <div class="order-status-tabs">
                <a href="/Orders?status=all" class="order-tab @(Model.StatusFilter == "all" ? "active" : "")">
                    All Orders
                </a>
                <a href="/Orders?status=pending" class="order-tab @(Model.StatusFilter == "pending" ? "active" : "")">
                    Pending (@Model.PendingCount)
                </a>
                <a href="/Orders?status=preparing" class="order-tab @(Model.StatusFilter == "preparing" ? "active" : "")">
                    Preparing (@Model.PreparingCount)
                </a>
                <a href="/Orders?status=ready" class="order-tab @(Model.StatusFilter == "ready" ? "active" : "")">
                    Ready (@Model.ReadyCount)
                </a>
                <a href="/Orders?status=completed" class="order-tab @(Model.StatusFilter == "completed" ? "active" : "")">
                    Completed (@Model.CompletedCount)
                </a>
            </div>
        </div>

        <!-- Orders Grid -->
        @if (!Model.Orders.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-filter fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">No orders found</h5>
                <p class="text-muted">No orders match the selected filter.</p>
                <a href="/Orders" class="btn btn-outline-primary">Show All Orders</a>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var order in Model.Orders)
                {
                    <div class="col-lg-6 col-xl-4 mb-4">
                        <div class="card h-100 shadow-sm border-0 order-card">
                            <!-- Card Header -->
                            <div class="card-header d-flex justify-content-between align-items-center" style="background:linear-gradient(135deg, #8c1007, #a31208);color:white;">
                                <div>
                                    <h6 class="mb-0 fw-bold">Order #@order.OrderId</h6>
                                    <small class="opacity-75">@order.TimeAgo</small>
                                </div>
                                <span class="badge @GetStatusBadgeClass(order.StatusName) fs-6">@order.StatusName</span>
                            </div>

                            <!-- Card Body -->
                            <div class="card-body p-3">
                                <!-- Order Date -->
                                <div class="mb-3">
                                    <small class="text-muted">
                                        <i class="fas fa-calendar me-1"></i>
                                        @order.OrderDate.ToString("MMM dd, yyyy 'at' hh:mm tt")
                                    </small>
                                </div>
                                
                                <!-- Items List -->
                                <div class="mb-3">
                                    <h6 class="mb-2 d-flex align-items-center">
                                        <i class="fas fa-utensils me-2 text-primary"></i>
                                        Items (@order.ItemCount):
                                    </h6>
                                    <div class="items-list">
                                        @foreach (var item in order.ItemNames.Take(3))
                                        {
                                            <span class="badge bg-light text-dark me-1 mb-1">@item</span>
                                        }
                                        @if (order.ItemNames.Count > 3)
                                        {
                                            <span class="badge bg-secondary">+@(order.ItemNames.Count - 3) more</span>
                                        }
                                    </div>
                                </div>

                                <!-- Delivery Info -->
                                @if (!string.IsNullOrEmpty(order.DeliveryAddress) && order.DeliveryAddress != "N/A")
                                {
                                    <div class="mb-3">
                                        <small class="text-muted">
                                            <i class="fas fa-map-marker-alt me-1"></i>
                                            @(order.DeliveryAddress.Length > 40 ? order.DeliveryAddress.Substring(0, 40) + "..." : order.DeliveryAddress)
                                        </small>
                                    </div>
                                }

                                <!-- Total Amount -->
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <span class="fw-bold" style="color:#8c1007;font-size:1.2rem;">
                                            &#8369;@order.TotalAmount.ToString("0.00")
                                        </span>
                                        @if (order.DeliveryFee > 0)
                                        {
                                            <small class="text-muted d-block">
                                                (incl. &#8369;@order.DeliveryFee.ToString("0.00") delivery)
                                            </small>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Card Footer -->
                            <div class="card-footer bg-transparent border-0 p-3 pt-0">
                                <div class="d-flex gap-2">
                                    <a href="/OrderConfirmation?orderId=@order.OrderId" class="btn btn-outline-primary btn-sm flex-fill">
                                        <i class="fas fa-eye me-1"></i>View Details
                                    </a>
                                    
                                    @if (order.StatusName == "Completed")
                                    {
                                        <form method="post" asp-page-handler="Reorder" class="flex-fill">
                                            <input type="hidden" name="orderId" value="@order.OrderId" />
                                            <button type="submit" class="btn btn-success btn-sm w-100" title="Reorder these items">
                                                <i class="fas fa-redo me-1"></i>Reorder
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</section>

@section Scripts {
    <script>
        // Auto-refresh orders every 30 seconds to update statuses
        setInterval(function() {
            // Only refresh if there are pending/preparing orders
            const hasPendingOrders = document.querySelector('.badge.bg-warning, .badge.bg-info');
            if (hasPendingOrders) {
                // Silent refresh without full page reload
                fetch(window.location.href + (window.location.search ? '&' : '?') + '_=' + Date.now())
                    .then(response => response.text())
                    .then(html => {
                        // Update only the status badges
                        const parser = new DOMParser();
                        const newDoc = parser.parseFromString(html, 'text/html');
                        const statusBadges = document.querySelectorAll('.badge');
                        const newStatusBadges = newDoc.querySelectorAll('.badge');
                        
                        statusBadges.forEach((badge, index) => {
                            if (newStatusBadges[index] && badge.textContent !== newStatusBadges[index].textContent) {
                                badge.className = newStatusBadges[index].className;
                                badge.textContent = newStatusBadges[index].textContent;
                                
                                // Highlight updated status
                                badge.style.animation = 'pulse 2s';
                            }
                        });
                    })
                    .catch(() => {
                        // Silent fail
                    });
            }
        }, 30000);

        // Reorder confirmation
        document.querySelectorAll('form[asp-page-handler="Reorder"]').forEach(form => {
            form.addEventListener('submit', function(e) {
                if (!confirm('Add all items from this order to your cart?')) {
                    e.preventDefault();
                }
            });
        });
    </script>
}

@section Styles {
    <style>
        .orders-page {
            background-color: #f8f9fa;
        }
        
        .order-status-tabs {
            display: flex;
            background: white;
            border-radius: 50px;
            padding: 8px;
            box-shadow: 0 2px 20px rgba(0,0,0,0.1);
            border: 1px solid #e9ecef;
            overflow-x: auto;
            white-space: nowrap;
        }
        
        .order-tab {
            padding: 12px 20px;
            text-decoration: none;
            color: #6c757d;
            font-weight: 500;
            border-radius: 25px;
            transition: all 0.3s ease;
            white-space: nowrap;
            border: none;
            background: transparent;
            position: relative;
            margin: 0 2px;
        }
        
        .order-tab:hover {
            color: #8c1007;
            background-color: rgba(140, 16, 7, 0.1);
            text-decoration: none;
        }
        
        .order-tab.active {
            background-color: #8c1007;
            color: white;
            box-shadow: 0 2px 10px rgba(140, 16, 7, 0.3);
        }
        
        .order-card {
            transition: all 0.3s ease;
        }
        
        .order-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(140, 16, 7, 0.15) !important;
        }
        
        .items-list .badge {
            font-size: 0.75rem;
        }
        
        @@keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }
        
        .orders-page .alert {
            border: none;
            border-radius: 8px;
        }
        
        /* Mobile responsiveness for tabs */
        @@media (max-width: 768px) {
            .order-status-tabs {
                justify-content: flex-start;
                padding: 6px;
            }
            
            .order-tab {
                padding: 10px 16px;
                font-size: 0.9rem;
            }
        }
        
        /* Tab indicator animation */
        .order-tab.active::before {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 50%;
            transform: translateX(-50%);
            width: 6px;
            height: 6px;
            background-color: white;
            border-radius: 50%;
        }
    </style>
}

@functions {
    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Pending" => "bg-warning text-dark",
            "Preparing" => "bg-info text-white",
            "Ready" => "bg-primary text-white",
            "Completed" => "bg-success text-white",
            "Cancelled" => "bg-danger text-white",
            _ => "bg-secondary text-white"
        };
    }
}