@page
@model PizzafyWeb.Pages.Admin.MenuManagementModel
@{
    ViewData["Title"] = "Menu Management";
    Layout = "_AdminLayout";
}

@functions {
    protected int GetSizeSortKey(string size)
    {
        var s = (size ?? string.Empty).Trim().ToLowerInvariant();
        // Named sizes first
        if (s.Contains("extra small") || s == "xs" || s.Contains("x-small")) return 0;
        if (s.Contains("small")) return 1;
        if (s.Contains("medium") || s == "md") return 2;
        if (s == "large") return 3;
        if (s.Contains("x-large") || s.Contains("extra large") || s == "xl") return 4;
        if (s.Contains("xx-large") || s.Contains("2x") || s == "xxl") return 5;

        // Numeric sizes like "9 in", "12 in", "14 in", or with units
        var m = System.Text.RegularExpressions.Regex.Match(s, @"(\d+\.?\d*)\s*(in|inch|inches|cm|mm|oz)");
        if (m.Success && decimal.TryParse(m.Groups[1].Value, out var v))
        {
            return 100 + (int)(v * 10); // order ascending by numeric value
        }

        // Plain numeric
        var m2 = System.Text.RegularExpressions.Regex.Match(s, @"^(\d+)$");
        if (m2.Success && int.TryParse(m2.Groups[1].Value, out var n))
        {
            return 100 + n;
        }

        // Unknowns at the end
        return 1000;
    }
}

<div class="admin-content">
    <div class="admin-header">
        <h1 class="page-title">Menu Management</h1>
        <div class="header-actions">
            <div class="search-container">
                <input type="text" class="form-control search-input" placeholder="Search products..." id="searchInput">
                <i class="fas fa-search search-icon"></i>
            </div>
            <a href="/Admin/AddProduct" class="btn btn-add-product">
                <i class="fas fa-plus me-2"></i>Add Product
            </a>
        </div>
    </div>

    <div class="category-tabs">
        <button type="button" class="category-tab @(Model.CurrentCategory == "All Categories" ? "active" : "")" 
                data-category="All Categories">
            All Categories
        </button>
        @foreach (var category in Model.Categories)
        {
            <button type="button" class="category-tab @(Model.CurrentCategory == category.CategoryName ? "active" : "")" 
                    data-category="@category.CategoryName">
                @category.CategoryName
            </button>
        }
    </div>

    <div class="products-table-container">
        <div id="loadingIndicator" class="loading-indicator" style="display: none;">
            <div class="loading-spinner"></div>
            <span>Loading products...</span>
        </div>

        <div class="table-header">
            <div class="table-header-cell">PRODUCT</div>
            <div class="table-header-cell">CATEGORY</div>
            <div class="table-header-cell">SIZE</div>
            <div class="table-header-cell">PRICE</div>
            <div class="table-header-cell">STATUS</div>
            <div class="table-header-cell">ACTIONS</div>
        </div>

        <div class="table-body" id="productsTableBody">
            @{
                var groupedItems = Model.MenuItems
                    .GroupBy(m => (m.ItemName ?? string.Empty).Trim(), StringComparer.OrdinalIgnoreCase)
                    .Select(g => new
                    {
                        ItemName = g.Key,
                        RepresentativeId = g.First().MenuItemId,
                        CategoryName = g.Select(x => x.Category.CategoryName)
                                        .Distinct(StringComparer.OrdinalIgnoreCase)
                                        .Count() > 1
                                        ? "Multiple"
                                        : g.First().Category.CategoryName,
                        Sizes = g.SelectMany(x => x.MenuPrices.Select(mp => mp.Size.SizeName))
                                 .Distinct()
                                 .ToList(),
                        Prices = g.SelectMany(x => x.MenuPrices.Select(mp => mp.UnitPrice))
                                  .ToList(),
                        IsAvailable = g.Any(x => x.IsAvailable) // if any variant available, treat as available
                    })
                    .OrderBy(x => x.CategoryName)
                    .ThenBy(x => x.ItemName)
                    .ToList();
            }

            @foreach (var item in groupedItems)
            {
                var orderedSizes = item.Sizes.OrderBy(s => GetSizeSortKey(s)).ThenBy(s => s);
                <div class="table-row" data-name="@item.ItemName.ToLower()" data-category="@item.CategoryName">
                    <div class="table-cell product-cell">
                        <div class="product-info">
                            <span class="product-name">@item.ItemName</span>
                        </div>
                    </div>

                    <div class="table-cell category-cell">
                        <span class="category-badge">@item.CategoryName</span>
                    </div>

                    <div class="table-cell size-cell">
                        @if (orderedSizes.Any())
                        {
                            <div class="size-info">
                                @foreach (var sizeName in orderedSizes)
                                {
                                    <span class="size-badge">@sizeName</span>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">No sizes</span>
                        }
                    </div>

                    <div class="table-cell price-cell">
                        @if (item.Prices.Any())
                        {
                            var minPrice = item.Prices.Min();
                            var maxPrice = item.Prices.Max();
                            if (minPrice == maxPrice)
                            {
                                <span class="price">₱@minPrice.ToString("F2")</span>
                            }
                            else
                            {
                                <span class="price">₱@minPrice.ToString("F2") - ₱@maxPrice.ToString("F2")</span>
                            }
                        }
                        else
                        {
                            <span class="price text-muted">No prices set</span>
                        }
                    </div>

                    <div class="table-cell status-cell">
                        @if (item.IsAvailable)
                        {
                            <span class="status-badge enabled">Active</span>
                        }
                        else
                        {
                            <span class="status-badge disabled">Disabled</span>
                        }
                    </div>

                    <div class="table-cell actions-cell">
                        <a href="/Admin/EditProduct?id=@item.RepresentativeId" class="btn-action btn-edit">
                            <i class="fas fa-edit"></i>
                            Edit
                        </a>
                        <form method="post" style="display: inline;" class="toggle-availability-form" data-name="@item.ItemName.ToLower()" data-id="@item.RepresentativeId">
                            <button type="button" data-id="@item.RepresentativeId" class="btn-action toggle-availability-btn @(item.IsAvailable ? "btn-disable" : "btn-enable")" data-available="@(item.IsAvailable ? "1" : "0")">
                                <i class="fas @(item.IsAvailable ? "fa-ban" : "fa-check")"></i>
                                @(item.IsAvailable ? "Disable" : "Enable")
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (!Model.MenuItems.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">
                <i class="fas fa-utensils"></i>
            </div>
            <h3>No products found</h3>
            <p>Start by adding your first product to the menu.</p>
            <a href="/Admin/AddProduct" class="btn btn-add-product">
                <i class="fas fa-plus me-2"></i>Add Product
            </a>
        </div>
    }

    @if (TempData["SuccessMessage"] != null && Request.Query["success"].Count > 0)
    {
        <div class="alert alert-success position-fixed top-0 end-0 m-4 fade show" style="z-index:9999; min-width:300px;">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close ms-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
</div>

@section Scripts {
    <script>
        let currentCategory = '@Model.CurrentCategory';
        let currentSearch = '';
        let allProducts = [];

        document.addEventListener('DOMContentLoaded', function() {
            // Cache all products for client-side filtering
            allProducts = Array.from(document.querySelectorAll('.table-row')).map(row => {
                return {
                    element: row,
                    name: row.getAttribute('data-name'),
                    category: row.getAttribute('data-category')
                };
            });

            const categoryTabs = document.querySelectorAll('.category-tab');
            categoryTabs.forEach(tab => {
                tab.addEventListener('click', function() {
                    categoryTabs.forEach(t => t.classList.remove('active'));
                    this.classList.add('active');
                    currentCategory = this.getAttribute('data-category');
                    filterProductsLocally();
                });
            });

            const searchInput = document.getElementById('searchInput');
            const searchIcon = document.querySelector('.search-icon');
            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    currentSearch = this.value.toLowerCase();
                    filterProductsLocally();
                });
            }
            if (searchIcon && searchInput) {
                searchIcon.style.cursor = 'pointer';
                searchIcon.addEventListener('click', function() {
                    currentSearch = searchInput.value.toLowerCase();
                    filterProductsLocally();
                    searchInput.focus();
                });
            }

            // Attach toggle availability handlers
            document.querySelectorAll('.toggle-availability-btn').forEach(btn => {
                btn.addEventListener('click', async function (e) {
                    const id = this.dataset.id;
                    const form = this.closest('.toggle-availability-form');
                    const name = form.dataset.name;
                    const currentlyAvailable = this.dataset.available === '1';
                    const confirmMsg = currentlyAvailable ? 'Are you sure you want to disable this product?' : 'Are you sure you want to enable this product?';
                    if (!confirm(confirmMsg)) return;

                    try {
                        const res = await fetch(`?handler=ToggleAvailability&id=${encodeURIComponent(id)}`, { method: 'POST', headers: { 'RequestVerificationToken': getAntiForgeryToken() } });
                        if (!res.ok) throw new Error('Request failed');
                        // Toggle button state and status badge in table
                        const newAvailable = !currentlyAvailable;
                        // Update state value on the button (1 = available/active, 0 = disabled)
                        this.dataset.available = newAvailable ? '1' : '0';
                        // Button class indicates the action (when active -> show Disable action, when disabled -> show Enable action)
                        if (newAvailable) {
                            this.classList.remove('btn-enable');
                            this.classList.add('btn-disable');
                        } else {
                            this.classList.remove('btn-disable');
                            this.classList.add('btn-enable');
                        }
                        // Update icon + label: when active show 'Disable', when disabled show 'Enable'
                        this.innerHTML = `<i class="fas ${newAvailable ? 'fa-ban' : 'fa-check'}"></i> ${newAvailable ? 'Disable' : 'Enable'}`;

                        const row = this.closest('.table-row');
                        const statusBadge = row.querySelector('.status-badge');
                        if (statusBadge) {
                            statusBadge.classList.toggle('enabled', newAvailable);
                            statusBadge.classList.toggle('disabled', !newAvailable);
                            statusBadge.textContent = newAvailable ? 'Active' : 'Disabled';
                        }

                        // Update product cards on product listing pages by matching data-name
                        document.querySelectorAll(`.product-card[data-name='${name}']`).forEach(card => {
                            const overlay = card.querySelector('.not-available-overlay');
                            const controls = card.querySelectorAll('.qty-select, .size-select, .add-to-cart-btn');
                            if (newAvailable) {
                                card.classList.remove('disabled');
                                if (overlay) overlay.style.display = 'none';
                                controls.forEach(c => c.disabled = false);
                            } else {
                                card.classList.add('disabled');
                                if (overlay) overlay.style.display = 'flex';
                                controls.forEach(c => c.disabled = true);
                            }
                        });

                    } catch (err) {
                        alert('Failed to update availability.');
                    }
                });
            });
        });

        function getAntiForgeryToken() {
            const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
            return tokenEl ? tokenEl.value : '';
        }

        function filterProductsLocally() {
            let hasVisibleRows = false;
            allProducts.forEach(product => {
                const matchesSearch = !currentSearch || (product.name && product.name.includes(currentSearch));
                const matchesCategory = currentCategory === 'All Categories' || 
                    (product.category && product.category.toLowerCase() === currentCategory.toLowerCase());
                const isVisible = matchesSearch && matchesCategory;
                product.element.style.display = isVisible ? 'flex' : 'none';
                if (isVisible) hasVisibleRows = true;
            });
            hasVisibleRows ? hideEmptyState() : showEmptyState();
        }

        function showEmptyState() {
            const emptyState = document.querySelector('.empty-state');
            if (emptyState) emptyState.style.display = 'flex';
        }

        function hideEmptyState() {
            const emptyState = document.querySelector('.empty-state');
            if (emptyState) emptyState.style.display = 'none';
        }
    </script>
}
