@section Scripts {
    <script>
        let currentOrderData = null;
        let currentCustomerOrders = null;

        // Customer search functionality
        document.getElementById('customerSearch').addEventListener('input', function(e) {
            const searchTerm = e.target.value.toLowerCase();
            const customerEntries = document.querySelectorAll('.customer-entry');
            
            customerEntries.forEach(entry => {
                const customerName = entry.querySelector('.customer-link').textContent.toLowerCase();
                if (customerName.includes(searchTerm)) {
                    entry.style.display = 'flex';
                } else {
                    entry.style.display = 'none';
                }
            });
        });

        async function viewCustomerOrders(customerName) {
            const modalEl = document.getElementById('customerOrdersModal');
            const modal = new bootstrap.Modal(modalEl);
            const content = document.getElementById('customerOrdersContent');
            document.getElementById('customerModalName').textContent = customerName;
            
            // Show loading
            content.innerHTML = `
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading orders...</p>
                </div>
            `;
            
            modal.show();

            // Filter customer orders from existing data (camelCase for JS)
            const customerOrders = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.CustomerPurchases,
                new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }
            ));
            const orders = customerOrders.filter(order => order.customerName === customerName);
            currentCustomerOrders = { customerName, orders };
            
            if (orders.length === 0) {
                content.innerHTML = `
                    <div class="text-center py-5 text-muted">
                        <i class="fas fa-receipt fa-3x mb-3"></i>
                        <h5>No Orders Found</h5>
                        <p>This customer has no orders in the selected date range.</p>
                    </div>
                `;
                return;
            }

            if (orders.length === 1) {
                // Directly open details for single order
                modal.hide();
                const orderId = orders[0].orderId;
                const handler = () => {
                    modalEl.removeEventListener('hidden.bs.modal', handler);
                    viewOrderDetails(orderId);
                };
                modalEl.addEventListener('hidden.bs.modal', handler);
                return;
            }

            // Multiple orders: show simple list of order numbers and dates
            content.innerHTML = `
                <div class="mb-3 text-muted">Select an order to view details</div>
                <div class="list-group">
                    ${orders
                        .sort((a, b) => new Date(b.orderDate) - new Date(a.orderDate))
                        .map(o => `
                            <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" onclick="openOrderFromCustomerModal(${o.orderId}); return false;">
                                <div>
                                    <strong class="text-primary">#${o.orderId}</strong>
                                    <div>
                                        <small class="text-muted">
                                            ${new Date(o.orderDate).toLocaleDateString()} ${new Date(o.orderDate).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}
                                        </small>
                                    </div>
                                </div>
                                <i class="fas fa-chevron-right text-muted"></i>
                            </a>
                        `).join('')}
                </div>
            `;
        }

        function openOrderFromCustomerModal(orderId) {
            const modalEl = document.getElementById('customerOrdersModal');
            const instance = bootstrap.Modal.getInstance(modalEl);
            if (instance) {
                const handler = () => {
                    modalEl.removeEventListener('hidden.bs.modal', handler);
                    viewOrderDetails(orderId);
                };
                modalEl.addEventListener('hidden.bs.modal', handler);
                instance.hide();
            } else {
                viewOrderDetails(orderId);
            }
        }

        function getStatusBadge(status) {
            const s = (status || '').toLowerCase();
            let cls;
            switch (s) {
                case 'pending': cls = 'bg-warning text-dark'; break;
                case 'confirmed': cls = 'bg-info text-white'; break;
                case 'preparing': cls = 'bg-primary text-white'; break;
                case 'ready': cls = 'bg-secondary text-white'; break;
                case 'completed': cls = 'bg-success text-white'; break;
                case 'cancelled': cls = 'bg-danger text-white'; break;
                default: cls = 'bg-light text-dark'; break;
            }
            return `<span class="badge ${cls}">${status}</span>`;
        }

        async function viewOrderDetails(orderId) {
            const modal = new bootstrap.Modal(document.getElementById('orderDetailsModal'));
            const content = document.getElementById('orderDetailsContent');
            
            // Show loading
            content.innerHTML = `
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading order details...</p>
                </div>
            `;
            
            modal.show();

            try {
                const response = await fetch(`?handler=OrderDetails&orderId=${orderId}`);
                if (!response.ok) throw new Error('Failed to load order details');
                
                const order = await response.json();
                currentOrderData = order;
                
                content.innerHTML = `
                    <div class="row">
                        <div class="col-md-6">
                            <h6><i class="fas fa-user me-2"></i>Customer Information</h6>
                            <div class="mb-3">
                                <strong>Name:</strong> ${order.customerName}<br/>
                                <strong>Phone:</strong> ${order.customerPhone || 'N/A'}<br/>
                                <strong>Address:</strong> ${order.deliveryAddress || 'N/A'}
                            </div>
                        </div>
                        <div class="col-md-6">
                            <h6><i class="fas fa-info-circle me-2"></i>Order Information</h6>
                            <div class="mb-3">
                                <strong>Order ID:</strong> #${order.orderId}<br/>
                                <strong>Date:</strong> ${order.orderDate}<br/>
                                <strong>Status:</strong> <span class="badge bg-info">${order.status}</span><br/>
                                <strong>Payment:</strong> ${order.paymentMethod}
                            </div>
                        </div>
                    </div>
                    
                    <h6><i class="fas fa-list me-2"></i>Order Items</h6>
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th>Size</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${order.items.map(item => `
                                    <tr>
                                        <td>${item.itemName}</td>
                                        <td><span class="badge bg-secondary">${item.size}</span></td>
                                        <td class="text-center">${item.quantity}</td>
                                        <td class="text-end">₱${parseFloat(item.unitPrice).toFixed(2)}</td>
                                        <td class="text-end">₱${parseFloat(item.subtotal).toFixed(2)}</td>
                                    </tr>
                                `).join('')}
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="4">Delivery Fee:</th>
                                    <th class="text-end">₱${parseFloat(order.deliveryFee).toFixed(2)}</th>
                                </tr>
                                <tr class="table-success">
                                    <th colspan="4">Total Amount:</th>
                                    <th class="text-end">₱${parseFloat(order.totalAmount).toFixed(2)}</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                `;
            } catch (error) {
                content.innerHTML = `
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        Failed to load order details. Please try again.
                    </div>
                `;
            }
        }

        function exportPurchases() {
            const purchases = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.CustomerPurchases,
                new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }
            ));
            const csv = generatePurchaseCSV(purchases);
            downloadCSV(csv, `purchases_${new Date().toISOString().split('T')[0]}.csv`);
        }

        function exportCustomerOrders() {
            if (!currentCustomerOrders) return;
            
            const csv = generatePurchaseCSV(currentCustomerOrders.orders);
            downloadCSV(csv, `${currentCustomerOrders.customerName.replace(/\s+/g, '_')}_orders_${new Date().toISOString().split('T')[0]}.csv`);
        }

        function exportOrderDetails() {
            if (!currentOrderData) return;
            
            const csv = generateOrderCSV(currentOrderData);
            downloadCSV(csv, `order_${currentOrderData.orderId}_${new Date().toISOString().split('T')[0]}.csv`);
        }

        function generatePurchaseCSV(purchases) {
            const headers = ['Order ID', 'Customer Name', 'Order Date', 'Total Amount', 'Status', 'Payment Method'];
            const rows = purchases.map(p => [
                p.orderId,
                p.customerName,
                new Date(p.orderDate).toLocaleString(),
                p.totalAmount,
                p.status,
                p.paymentMethod
            ]);
            
            return [headers, ...rows].map(row => 
                row.map(field => `"${field}"`).join(',')
            ).join('\n');
        }

        function generateOrderCSV(order) {
            const headers = ['Item Name', 'Size', 'Quantity', 'Unit Price', 'Subtotal'];
            const rows = order.items.map(item => [
                item.itemName,
                item.size,
                item.quantity,
                item.unitPrice,
                item.subtotal
            ]);
            
            const csv = [headers, ...rows].map(row => 
                row.map(field => `"${field}"`).join(',')
            ).join('\n');
            
            return `Order #${order.orderId} - ${order.customerName}\n` +
                   `Date: ${order.orderDate}\n` +
                   `Status: ${order.status}\n` +
                   `Payment: ${order.paymentMethod}\n\n` +
                   csv +
                   `\n\nDelivery Fee,,,,"${order.deliveryFee}"` +
                   `\nTotal Amount,,,,"${order.totalAmount}"`;
        }

        function downloadCSV(csv, filename) {
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            if (link.download !== undefined) {
                const url = URL.createObjectURL(blob);
                link.setAttribute('href', url);
                link.setAttribute('download', filename);
                link.style.visibility = 'hidden';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            }
        }
    </script>
}
