@page
@model PizzafyWeb.Pages.Admin.MenuManagementModel
@{
    ViewData["Title"] = "Menu Management";
    Layout = "_AdminLayout";
}

<!-- Hidden antiforgery token for AJAX -->
<form method="post" style="display:none">@Html.AntiForgeryToken()</form>

<div class="admin-content">
    <div class="admin-header">
        <h1 class="page-title">Menu Management</h1>
        <div class="header-actions">
            <div class="search-container">
                <input type="text" class="form-control search-input" placeholder="Search products..." id="searchInput">
                <i class="fas fa-search search-icon"></i>
            </div>
            <a href="/Admin/AddProduct" class="btn btn-add-product">
                <i class="fas fa-plus me-2"></i>Add Product
            </a>
        </div>
    </div>

    <div class="category-tabs">
        <button type="button" class="category-tab @(Model.CurrentCategory == "All Categories" ? "active" : "")" 
                data-category="All Categories">
            All Categories
        </button>
        @foreach (var category in Model.Categories)
        {
            <button type="button" class="category-tab @(Model.CurrentCategory == category.CategoryName ? "active" : "")" 
                    data-category="@category.CategoryName">
                @category.CategoryName
            </button>
        }
    </div>

    <div class="products-table-container">
        <div id="loadingIndicator" class="loading-indicator" style="display: none;">
            <div class="loading-spinner"></div>
            <span>Loading products...</span>
        </div>

        <div class="table-header">
            <div class="table-header-cell">PRODUCT</div>
            <div class="table-header-cell">CATEGORY</div>
            <div class="table-header-cell">SIZE</div>
            <div class="table-header-cell">PRICE</div>
            <div class="table-header-cell">STATUS</div>
            <div class="table-header-cell">ACTIONS</div>
        </div>

        <div class="table-body" id="productsTableBody">
            @{
                var groupedItems = Model.MenuItems
                    .GroupBy(m => (m.ItemName ?? string.Empty).Trim(), StringComparer.OrdinalIgnoreCase)
                    .Select(g => new
                    {
                        ItemName = g.Key,
                        RepresentativeId = g.First().MenuItemId,
                        CategoryName = g.Select(x => x.Category.CategoryName)
                                        .Distinct(StringComparer.OrdinalIgnoreCase)
                                        .Count() > 1
                                        ? "Multiple"
                                        : g.First().Category.CategoryName,
                        Image = g.Select(x => x.Image).FirstOrDefault(img => !string.IsNullOrWhiteSpace(img)) ?? g.First().Image,
                        Sizes = g.SelectMany(x => x.MenuPrices)
                                 .GroupBy(mp => new { mp.Size.SizeId, mp.Size.SizeName })
                                 .Select(gg => new {
                                     PriceId = gg.OrderBy(p => p.UnitPrice).First().PriceId,
                                     SizeId = gg.Key.SizeId,
                                     SizeName = gg.Key.SizeName,
                                     IsAvailable = gg.Any(p => p.IsAvailable)
                                 })
                                 .OrderBy(x => GetSizeSortKey(x.SizeName))
                                 .ThenBy(x => x.SizeName)
                                 .ToList(),
                        Prices = g.SelectMany(x => x.MenuPrices.Select(mp => mp.UnitPrice))
                                  .ToList()
                    })
                    .OrderBy(x => x.CategoryName)
                    .ThenBy(x => x.ItemName)
                    .ToList();
            }

            @foreach (var item in groupedItems)
            {
                var sizes = item.Sizes.ToList();
                var total = sizes.Count;
                var enabledCount = sizes.Count(s => s.IsAvailable);
                var statusText = enabledCount == 0 ? "Inactive" : enabledCount == total ? "Active" : "Partial";
                var statusClass = enabledCount == 0 ? "badge bg-danger" : enabledCount == total ? "badge bg-success" : "badge bg-warning text-dark";
                <div class="table-row" data-name="@item.ItemName.ToLower()" data-category="@item.CategoryName" data-item-name="@item.ItemName">
                    <div class="table-cell product-cell">
                        <div class="product-info" style="display:flex;align-items:center;gap:12px;">
                            @if (!string.IsNullOrWhiteSpace(item.Image))
                            {
                                <img src="/images/products/@item.Image" alt="@item.ItemName" style="width:40px;height:40px;border-radius:6px;object-fit:cover;border:1px solid #eee;" />
                            }
                            else
                            {
                                <div style="width:40px;height:40px;border-radius:6px;background:#f1f3f5;display:flex;align-items:center;justify-content:center;color:#6c757d;border:1px solid #eee;">
                                    <i class="fas fa-image"></i>
                                </div>
                            }
                            <span class="product-name">@item.ItemName</span>
                        </div>
                    </div>

                    <div class="table-cell category-cell">
                        <span class="category-badge">@item.CategoryName</span>
                    </div>

                    <div class="table-cell size-cell">
                        @if (sizes.Any())
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var s in sizes)
                                {
                                    <div class="border rounded px-3 py-2 d-flex align-items-center" title="Click to enable or disable this size.">
                                        <span class="me-2 fw-semibold">@FormatSizeLabel(s.SizeName)</span>
                                        <div class="form-check form-switch m-0">
                                            @if (s.IsAvailable)
                                            {
                                                <input class="form-check-input size-toggle" type="checkbox" data-price-id="@s.PriceId" data-size-name="@FormatSizeLabel(s.SizeName)" data-item-name="@item.ItemName" checked />
                                            }
                                            else
                                            {
                                                <input class="form-check-input size-toggle" type="checkbox" data-price-id="@s.PriceId" data-size-name="@FormatSizeLabel(s.SizeName)" data-item-name="@item.ItemName" />
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">No sizes</span>
                        }
                    </div>

                    <div class="table-cell price-cell">
                        @if (item.Prices.Any())
                        {
                            var minPrice = item.Prices.Min();
                            var maxPrice = item.Prices.Max();
                            if (minPrice == maxPrice)
                            {
                                <span class="price">&#8369;@minPrice.ToString("F2")</span>
                            }
                            else
                            {
                                <span class="price">&#8369;@minPrice.ToString("F2") - &#8369;@maxPrice.ToString("F2")</span>
                            }
                        }
                        else
                        {
                            <span class="price text-muted">No prices set</span>
                        }
                    </div>

                    <div class="table-cell status-cell">
                        <span class="status-badge @statusClass" data-status-badge>@statusText</span>
                    </div>

                    <div class="table-cell actions-cell">
                        <a href="/Admin/EditProduct?id=@item.RepresentativeId" class="btn-action btn-edit">
                            <i class="fas fa-edit"></i>
                            Edit
                        </a>
                        <div class="d-inline-flex gap-2" data-all-actions>
                            @if (enabledCount == 0)
                            {
                                <button type="button" class="btn-action btn-success all-on" data-item-name="@item.ItemName">
                                    <i class="fas fa-check"></i> Enable All
                                </button>
                            }
                            else if (enabledCount == total)
                            {
                                <button type="button" class="btn-action btn-danger all-off" data-item-name="@item.ItemName">
                                    <i class="fas fa-ban"></i> Disable All
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn-action btn-success all-on" data-item-name="@item.ItemName">
                                    <i class="fas fa-check"></i> Enable All
                                </button>
                                <button type="button" class="btn-action btn-danger all-off" data-item-name="@item.ItemName">
                                    <i class="fas fa-ban"></i> Disable All
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (!Model.MenuItems.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">
                <i class="fas fa-utensils"></i>
            </div>
            <h3>No products found</h3>
            <p>Start by adding your first product to the menu.</p>
            <a href="/Admin/AddProduct" class="btn btn-add-product">
                <i class="fas fa-plus me-2"></i>Add Product
            </a>
        </div>
    }

    @if (TempData["SuccessMessage"] != null && Request.Query["success"].Count > 0)
    {
        <div class="alert alert-success position-fixed top-0 end-0 m-4 fade show" style="z-index:9999; min-width:300px;">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close ms-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
</div>

@section Scripts {
    <script>
        let currentCategory = '@Model.CurrentCategory';
        let currentSearch = '';
        let allProducts = [];

        document.addEventListener('DOMContentLoaded', function() {
            // Cache all products for client-side filtering
            allProducts = Array.from(document.querySelectorAll('.table-row')).map(row => {
                return {
                    element: row,
                    name: row.getAttribute('data-name'),
                    category: row.getAttribute('data-category')
                };
            });

            const categoryTabs = document.querySelectorAll('.category-tab');
            categoryTabs.forEach(tab => {
                tab.addEventListener('click', function() {
                    categoryTabs.forEach(t => t.classList.remove('active'));
                    this.classList.add('active');
                    currentCategory = this.getAttribute('data-category');
                    filterProductsLocally();
                });
            });

            const searchInput = document.getElementById('searchInput');
            const searchIcon = document.querySelector('.search-icon');
            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    currentSearch = this.value.toLowerCase();
                    filterProductsLocally();
                });
            }
            if (searchIcon && searchInput) {
                searchIcon.style.cursor = 'pointer';
                searchIcon.addEventListener('click', function() {
                    currentSearch = searchInput.value.toLowerCase();
                    filterProductsLocally();
                    searchInput.focus();
                });
            }

            // Toggle per-size availability via switch
            document.querySelectorAll('.size-toggle').forEach(sw => {
                sw.addEventListener('change', async function() {
                    const priceId = this.dataset.priceId;
                    const sizeName = this.dataset.sizeName;
                    const itemName = this.dataset.itemName;
                    const row = this.closest('.table-row');
                    try {
                        const res = await fetch(`?handler=ToggleSizeAvailability&priceId=${encodeURIComponent(priceId)}`, { method: 'POST', headers: { 'RequestVerificationToken': getAntiForgeryToken() } });
                        const data = await res.json();
                        if (!res.ok || !data.ok) throw new Error(data.error || 'Request failed');
                        const isEnabled = data.isAvailable;
                        // sync switch state with server (in case of mismatch)
                        this.checked = !!isEnabled;
                        // Update status and All buttons
                        updateRowStatus(row);

                        // Reflect on product cards dropdown options
                        const nameKey = (itemName || '').toLowerCase();
                        document.querySelectorAll(`.product-card[data-name='${nameKey}'] .size-select option`).forEach(opt => {
                            const raw = (opt.textContent || '').trim();
                            const plain = raw.replace(/\s*-\s*Unavailable$/i, '');
                            if (plain.toLowerCase() === (sizeName || '').toLowerCase()) {
                                opt.disabled = !isEnabled;
                                opt.textContent = isEnabled ? plain : `${plain} - Unavailable`;
                            }
                        });
                        document.querySelectorAll(`.product-card[data-name='${nameKey}']`).forEach(card => {
                            const sizeSel = card.querySelector('.size-select');
                            const priceEl = card.querySelector('.product-price');
                            if (!sizeSel || !priceEl) return;
                            if (sizeSel.options[sizeSel.selectedIndex]?.disabled) {
                                const idx = Array.from(sizeSel.options).findIndex(o => !o.disabled);
                                if (idx >= 0) sizeSel.selectedIndex = idx;
                            }
                            const opt = sizeSel.options[sizeSel.selectedIndex];
                            const p = parseFloat(opt?.dataset.price);
                            if (!isNaN(p)) priceEl.textContent = `\u20B1${p.toFixed(2)}`;
                            const addBtn = card.querySelector('.add-to-cart-btn');
                            const anyAvailable = Array.from(sizeSel.options).some(o => !o.disabled);
                            if (addBtn) addBtn.disabled = !anyAvailable;
                        });
                    } catch (e) {
                        alert('Failed to toggle size availability.');
                        this.checked = !this.checked;
                    }
                });
            });

            // All OFF/ON buttons
            document.querySelectorAll('.all-off, .all-on').forEach(btn => {
                btn.addEventListener('click', async function() {
                    const row = this.closest('.table-row');
                    const name = this.dataset.itemName || row.getAttribute('data-item-name');
                    const enable = this.classList.contains('all-on');
                    try {
                        const res = await fetch(`?handler=SetAllSizes&itemName=${encodeURIComponent(name)}&enable=${enable}`, { method: 'POST', headers: { 'RequestVerificationToken': getAntiForgeryToken() } });
                        const data = await res.json().catch(() => ({ ok: res.ok }));
                        if (!res.ok || data.ok === false) throw new Error(data.error || 'Request failed');
                        // Update all switches in the row
                        row.querySelectorAll('.size-toggle').forEach(sw => sw.checked = enable);
                        updateRowStatus(row);

                        // Reflect on product cards for this item
                        const nameKey = (name || '').toLowerCase();
                        document.querySelectorAll(`.product-card[data-name='${nameKey}'] .size-select option`).forEach(opt => {
                            const raw = (opt.textContent || '').trim();
                            const plain = raw.replace(/\s*-\s*Unavailable$/i, '');
                            opt.disabled = !enable ? true : false; // if enabling, all enabled; if disabling, all disabled
                            opt.textContent = enable ? plain : `${plain} - Unavailable`;
                        });
                        document.querySelectorAll(`.product-card[data-name='${nameKey}']`).forEach(card => {
                            const sizeSel = card.querySelector('.size-select');
                            const priceEl = card.querySelector('.product-price');
                            if (!sizeSel || !priceEl) return;
                            if (sizeSel.options[sizeSel.selectedIndex]?.disabled) {
                                const idx = Array.from(sizeSel.options).findIndex(o => !o.disabled);
                                if (idx >= 0) sizeSel.selectedIndex = idx;
                            }
                            const opt = sizeSel.options[sizeSel.selectedIndex];
                            const p = parseFloat(opt?.dataset.price);
                            if (!isNaN(p)) priceEl.textContent = `\u20B1${p.toFixed(2)}`;
                            const addBtn = card.querySelector('.add-to-cart-btn');
                            const anyAvailable = Array.from(sizeSel.options).some(o => !o.disabled);
                            if (addBtn) addBtn.disabled = !anyAvailable;
                        });
                    } catch (e) {
                        alert('Failed to update sizes.');
                    }
                });
            });
        });

        function getAntiForgeryToken() {
            const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
            return tokenEl ? tokenEl.value : '';
        }

        function filterProductsLocally() {
            let hasVisibleRows = false;
            allProducts.forEach(product => {
                const matchesSearch = !currentSearch || (product.name && product.name.includes(currentSearch));
                const matchesCategory = currentCategory === 'All Categories' || 
                    (product.category && product.category.toLowerCase() === currentCategory.toLowerCase());
                const isVisible = matchesSearch && matchesCategory;
                product.element.style.display = isVisible ? 'flex' : 'none';
                if (isVisible) hasVisibleRows = true;
            });
            hasVisibleRows ? hideEmptyState() : showEmptyState();
        }

        function updateRowStatus(row) {
            const toggles = row.querySelectorAll('.size-toggle');
            const total = toggles.length;
            const enabled = Array.from(toggles).filter(t => t.checked).length;
            const badge = row.querySelector('[data-status-badge]');
            const actions = row.querySelector('[data-all-actions]');

            if (enabled === 0) {
                badge.textContent = 'Inactive';
                badge.className = 'status-badge badge bg-danger';
                actions.innerHTML = `<button type="button" class="btn-action btn-success all-on" data-item-name="${row.getAttribute('data-item-name')}"><i class="fas fa-check"></i> Enable All</button>`;
                actions.querySelector('.all-on').addEventListener('click', allBtnHandler);
            } else if (enabled === total) {
                badge.textContent = 'Active';
                badge.className = 'status-badge badge bg-success';
                actions.innerHTML = `<button type="button" class="btn-action btn-danger all-off" data-item-name="${row.getAttribute('data-item-name')}"><i class="fas fa-ban"></i> Disable All</button>`;
                actions.querySelector('.all-off').addEventListener('click', allBtnHandler);
            } else {
                badge.textContent = 'Partial';
                badge.className = 'status-badge badge bg-warning text-dark';
                actions.innerHTML = `
                    <button type="button" class="btn-action btn-success all-on" data-item-name="${row.getAttribute('data-item-name')}"><i class="fas fa-check"></i> Enable All</button>
                    <button type="button" class="btn-action btn-danger all-off" data-item-name="${row.getAttribute('data-item-name')}"><i class="fas fa-ban"></i> Disable All</button>`;
                actions.querySelector('.all-off').addEventListener('click', allBtnHandler);
                actions.querySelector('.all-on').addEventListener('click', allBtnHandler);
            }
        }

        async function allBtnHandler(e) {
            const btn = e.currentTarget;
            const row = btn.closest('.table-row');
            const name = btn.dataset.itemName || row.getAttribute('data-item-name');
            const enable = btn.classList.contains('all-on');
            try {
                const res = await fetch(`?handler=SetAllSizes&itemName=${encodeURIComponent(name)}&enable=${enable}`, { method: 'POST', headers: { 'RequestVerificationToken': getAntiForgeryToken() } });
                const data = await res.json().catch(() => ({ ok: res.ok }));
                if (!res.ok || data.ok === false) throw new Error(data.error || 'Request failed');
                row.querySelectorAll('.size-toggle').forEach(sw => sw.checked = enable);
                updateRowStatus(row);
            } catch (err) {
                alert('Failed to update sizes.');
            }
        }

        function showEmptyState() {
            const emptyState = document.querySelector('.empty-state');
            if (emptyState) emptyState.style.display = 'flex';
        }

        function hideEmptyState() {
            const emptyState = document.querySelector('.empty-state');
            if (emptyState) emptyState.style.display = 'none';
        }
    </script>
}

@using System.Text.RegularExpressions
@functions {
    public static string FormatSizeLabel(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return name ?? string.Empty;
        var m = Regex.Match(name, "\\((\\d+)\\s*oz\\)", RegexOptions.IgnoreCase);
        if (m.Success)
        {
            return $"{m.Groups[1].Value}oz"; // e.g., Small (8 oz) -> 8oz
        }
        return name!;
    }
    public static double GetSizeSortKey(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return double.MaxValue;
        var n = name!.Trim();
        // Named sizes
        if (n.Equals("Small", StringComparison.OrdinalIgnoreCase)) return 1;
        if (n.Equals("Medium", StringComparison.OrdinalIgnoreCase)) return 2;
        if (n.Equals("Large", StringComparison.OrdinalIgnoreCase)) return 3;
        // Extract number with optional unit
        var mNum = Regex.Match(n, @"(\d+(?:\.\d+)?)\s*(oz|in)?", RegexOptions.IgnoreCase);
        if (mNum.Success && double.TryParse(mNum.Groups[1].Value, out var v))
        {
            return v;
        }
        // Try to extract from parentheses e.g., Small (8 oz)
        var mParen = Regex.Match(n, @"\((\d+(?:\.\d+)?)\s*oz\)", RegexOptions.IgnoreCase);
        if (mParen.Success && double.TryParse(mParen.Groups[1].Value, out var v2))
        {
            return v2;
        }
        return double.MaxValue;
    }
}
