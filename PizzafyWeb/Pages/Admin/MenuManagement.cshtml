@page
@model PizzafyWeb.Pages.Admin.MenuManagementModel
@{
    ViewData["Title"] = "Menu Management";
    Layout = "_AdminLayout";
}

<div class="admin-content">
    <div class="admin-header">
        <h1 class="page-title">Menu Management</h1>
        <div class="header-actions">
            <div class="search-container">
                <input type="text" class="form-control search-input" placeholder="Search products..." id="searchInput">
                <i class="fas fa-search search-icon"></i>
            </div>
            <a href="/Admin/AddProduct" class="btn btn-add-product">
                <i class="fas fa-plus me-2"></i>Add Product
            </a>
        </div>
    </div>

    <div class="category-tabs">
        <button type="button" class="category-tab @(Model.CurrentCategory == "All Categories" ? "active" : "")" 
                data-category="All Categories">
            All Categories
        </button>
        @foreach (var category in Model.Categories)
        {
            <button type="button" class="category-tab @(Model.CurrentCategory == category.CategoryName ? "active" : "")" 
                    data-category="@category.CategoryName">
                @category.CategoryName
            </button>
        }
    </div>

    <div class="products-table-container">
        <div id="loadingIndicator" class="loading-indicator" style="display: none;">
            <div class="loading-spinner"></div>
            <span>Loading products...</span>
        </div>

        <div class="table-header">
            <div class="table-header-cell">PRODUCT</div>
            <div class="table-header-cell">CATEGORY</div>
            <div class="table-header-cell">SIZE</div>
            <div class="table-header-cell">PRICE</div>
            <div class="table-header-cell">STATUS</div>
            <div class="table-header-cell">ACTIONS</div>
        </div>

        <div class="table-body" id="productsTableBody">
            @foreach (var item in Model.MenuItems)
            {
                <div class="table-row" data-name="@item.ItemName.ToLower()" data-category="@item.Category.CategoryName">
                    <div class="table-cell product-cell">
                        <div class="product-info">
                            <span class="product-name">@item.ItemName</span>
                        </div>
                    </div>

                    <div class="table-cell category-cell">
                        <span class="category-badge">@item.Category.CategoryName</span>
                    </div>

                    <div class="table-cell size-cell">
                        @if (item.MenuPrices.Any())
                        {
                            <div class="size-info">
                                @foreach (var price in item.MenuPrices.OrderBy(p => p.UnitPrice))
                                {
                                    <span class="size-badge">@price.Size.SizeName</span>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">No sizes</span>
                        }
                    </div>

                    <div class="table-cell price-cell">
                        @if (item.MenuPrices.Any())
                        {
                            if (item.MenuPrices.Count == 1)
                            {
                                <span class="price">₱@(item.MenuPrices.First().UnitPrice.ToString("F2"))</span>
                            }
                            else
                            {
                                var minPrice = item.MenuPrices.Min(p => p.UnitPrice);
                                var maxPrice = item.MenuPrices.Max(p => p.UnitPrice);
                                <span class="price">₱@(minPrice.ToString("F2")) - ₱@(maxPrice.ToString("F2"))</span>
                            }
                        }
                        else
                        {
                            <span class="price text-muted">No prices set</span>
                        }
                    </div>

                    <div class="table-cell status-cell">
                        <span class="status-badge enabled">Active</span>
                    </div>

                    <div class="table-cell actions-cell">
                        <a href="/Admin/EditProduct?id=@item.MenuItemId" class="btn-action btn-edit">
                            <i class="fas fa-edit"></i>
                            Edit
                        </a>
                        <form method="post" style="display: inline;">
                            <button type="submit" asp-page-handler="Delete" asp-route-id="@item.MenuItemId"
                                    class="btn-action btn-disable"
                                    onclick="return confirm('Are you sure you want to delete this product?')">
                                <i class="fas fa-trash"></i>
                                Delete
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (!Model.MenuItems.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">
                <i class="fas fa-utensils"></i>
            </div>
            <h3>No products found</h3>
            <p>Start by adding your first product to the menu.</p>
            <a href="/Admin/AddProduct" class="btn btn-add-product">
                <i class="fas fa-plus me-2"></i>Add Product
            </a>
        </div>
    }

    @if (TempData["SuccessMessage"] != null && Request.Query["success"].Count > 0)
    {
        <div class="alert alert-success position-fixed top-0 end-0 m-4 fade show" style="z-index:9999; min-width:300px;">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close ms-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
</div>

@section Scripts {
    <script>
        let currentCategory = '@Model.CurrentCategory';
        let currentSearch = '';
        let allProducts = [];

        document.addEventListener('DOMContentLoaded', function() {
            // Cache all products for client-side filtering
            allProducts = Array.from(document.querySelectorAll('.table-row')).map(row => {
                return {
                    element: row,
                    name: row.getAttribute('data-name'),
                    category: row.getAttribute('data-category')
                };
            });

            const categoryTabs = document.querySelectorAll('.category-tab');
            categoryTabs.forEach(tab => {
                tab.addEventListener('click', function() {
                    categoryTabs.forEach(t => t.classList.remove('active'));
                    this.classList.add('active');
                    currentCategory = this.getAttribute('data-category');
                    filterProductsLocally();
                });
            });

            const searchInput = document.getElementById('searchInput');
            const searchIcon = document.querySelector('.search-icon');
            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    currentSearch = this.value.toLowerCase();
                    filterProductsLocally();
                });
            }
            if (searchIcon && searchInput) {
                searchIcon.style.cursor = 'pointer';
                searchIcon.addEventListener('click', function() {
                    currentSearch = searchInput.value.toLowerCase();
                    filterProductsLocally();
                    searchInput.focus();
                });
            }
        });

        function filterProductsLocally() {
            let hasVisibleRows = false;
            allProducts.forEach(product => {
                const matchesSearch = !currentSearch || (product.name && product.name.includes(currentSearch));
                const matchesCategory = currentCategory === 'All Categories' || 
                    (product.category && product.category.toLowerCase() === currentCategory.toLowerCase());
                const isVisible = matchesSearch && matchesCategory;
                product.element.style.display = isVisible ? 'flex' : 'none';
                if (isVisible) hasVisibleRows = true;
            });
            hasVisibleRows ? hideEmptyState() : showEmptyState();
        }

        function showEmptyState() {
            const emptyState = document.querySelector('.empty-state');
            if (emptyState) emptyState.style.display = 'flex';
        }

        function hideEmptyState() {
            const emptyState = document.querySelector('.empty-state');
            if (emptyState) emptyState.style.display = 'none';
        }
    </script>
}
