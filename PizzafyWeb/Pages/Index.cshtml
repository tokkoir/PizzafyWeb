@page
@model IndexModel
@using PizzafyWeb.Models
@{
    ViewData["Title"] = "Home";
}

<!-- Alert Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Hero Section with bg.png Background -->
<section class="hero-section-new">
    <div class="hero-content-new">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8 text-center">
                    <h1 class="hero-title-new">
                        Where every<br>
                        bite tastes<br>
                        like home
                    </h1>
                    
                    @if (!User.Identity!.IsAuthenticated)
                    {
                        <div class="hero-buttons mt-5">
                            <a href="/Register" class="btn btn-hero btn-order">Get Started</a>
                            <a href="#features" class="btn btn-hero btn-menu">Learn More</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@if (User.Identity!.IsAuthenticated)
{
    <!-- Menu Category Section for Authenticated Users -->
    <section id="menu-section" class="menu-category-section" style="background:#FFF8DC; padding: 4rem 0; min-height: 100vh;">
        <div class="container">
            <div class="row mb-5">
                <div class="col-12 text-center">
                    <h2 style="color:#8c1007;font-weight:900;font-size:3.5rem;letter-spacing:4px;margin-bottom:3rem;text-transform:uppercase;">MENU</h2>
                    
                    <!-- Search Bar -->
                    <div class="search-container mb-4">
                        <div class="position-relative d-inline-block">
                            <input type="text" id="searchInput" class="form-control search-input" style="width:450px;height:60px;border-radius:30px;border:3px solid #ddd;padding-left:25px;padding-right:60px;font-size:1.2rem;box-shadow:0 4px 15px rgba(0,0,0,0.1);" placeholder="Search in menu" />
                            <button class="search-btn position-absolute" style="right:10px;top:10px;width:40px;height:40px;border-radius:50%;background:#8c1007;border:none;color:white;display:flex;align-items:center;justify-content:center;">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>
                    
                    <!-- Category Icons with Labels (aligned) -->
                    <div class="category-chooser mb-5">
                        <div class="d-flex justify-content-center align-items-start" style="gap:60px; flex-wrap:wrap;">
                            <div class="category-item text-center">
                                <button class="category-btn active" data-category="all" style="background:#8c1007;color:white;border:none;border-radius:18px;width:90px;height:90px;margin:0;font-size:2.2rem;box-shadow:0 6px 20px rgba(140,16,7,0.4);transition:all 0.3s ease;">
                                    <i class="fas fa-th-large"></i>
                                </button>
                                <div class="mt-2">
                                    <small style="color:#8c1007;font-weight:700;font-size:0.9rem;">ALL</small>
                                </div>
                            </div>
                            <div class="category-item text-center">
                                <button class="category-btn" data-category="pizza" style="background:#8c1007;color:white;border:none;border-radius:18px;width:90px;height:90px;margin:0;font-size:2.2rem;box-shadow:0 6px 20px rgba(140,16,7,0.4);transition:all 0.3s ease;">
                                    <i class="fas fa-pizza-slice"></i>
                                </button>
                                <div class="mt-2">
                                    <small style="color:#8c1007;font-weight:700;font-size:0.9rem;">PIZZA</small>
                                </div>
                            </div>
                            <div class="category-item text-center">
                                <button class="category-btn" data-category="sides" style="background:#8c1007;color:white;border:none;border-radius:18px;width:90px;height:90px;margin:0;font-size:2.2rem;box-shadow:0 6px 20px rgba(140,16,7,0.4);transition:all 0.3s ease;">
                                    <i class="fas fa-hamburger"></i>
                                </button>
                                <div class="mt-2">
                                    <small style="color:#8c1007;font-weight:700;font-size:0.9rem;">SIDES</small>
                                </div>
                            </div>
                            <div class="category-item text-center">
                                <button class="category-btn" data-category="beverages" style="background:#8c1007;color:white;border:none;border-radius:18px;width:90px;height:90px;margin:0;font-size:2.2rem;box-shadow:0 6px 20px rgba(140,16,7,0.4);transition:all 0.3s ease;">
                                    <i class="fas fa-glass-whiskey"></i>
                                </button>
                                <div class="mt-2">
                                    <small style="color:#8c1007;font-weight:700;font-size:0.9rem;">BEVERAGES</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Loading Indicator -->
            <div id="loadingIndicator" class="text-center" style="display:none;">
                <div class="spinner-border text-danger" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
            
            <!-- Product Cards Container -->
            <div class="row justify-content-center" id="product-container">
                @await Html.PartialAsync("_ProductCards", Model.PizzaProducts)
            </div>
            
            <!-- Pagination -->
            <div class="row mt-5" id="pagination-container" style="display:none;">
                <div class="col-12 d-flex justify-content-center">
                    <nav aria-label="Product pagination">
                        <ul class="pagination" id="pagination-list" style="gap:12px;">
                            <!-- Pagination buttons will be dynamically generated -->
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </section>
}
else
{
    <!-- Features Section for Non-Authenticated Users -->
    <section class="features-section py-5" id="features">
        <div class="container">
            <div class="row">
                <div class="col-12 text-center mb-5">
                    <h2 class="section-title">Why Choose Pizzafy?</h2>
                    <p class="section-subtitle">Experience the difference that quality makes</p>
                </div>
            </div>
            
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-shipping-fast"></i>
                        </div>
                        <h4>Lightning Fast Delivery</h4>
                        <p>Hot, fresh pizza delivered to your door in 30 minutes or less - guaranteed!</p>
                    </div>
                </div>
                
                <div class="col-lg-4 col-md-6">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-seedling"></i>
                        </div>
                        <h4>Premium Ingredients</h4>
                        <p>We source only the finest, freshest ingredients from trusted local suppliers</p>
                    </div>
                </div>
                
                <div class="col-lg-4 col-md-6">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-percentage"></i>
                        </div>
                        <h4>Amazing Deals</h4>
                        <p>Enjoy exclusive discounts and special offers on your favorite pizzas every day</p>
                    </div>
                </div>
            </div>
            
            <!-- Call to Action -->
            <div class="row mt-5">
                <div class="col-12 text-center">
                    <div class="cta-section">
                        <h3>Ready to get started?</h3>
                        <p>Join thousands of satisfied customers who choose Pizzafy</p>
                        <div class="cta-buttons mt-4">
                            <a href="/Register" class="btn btn-cta btn-primary">Create Account</a>
                            <a href="/Login" class="btn btn-cta btn-outline">Sign In</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

