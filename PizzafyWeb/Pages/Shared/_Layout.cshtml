<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pizzafy</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PizzafyWeb.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@ViewData["BodyClass"]">
    <header class="pizzafy-header position-fixed w-100 top-0 start-0" style="z-index: 1050;">
        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid px-4">
                <!-- Logo and Brand -->
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-page="/Index">
                    <div class="header-logo-container">
                        <img src="~/images/logoWhiteOutline.png" alt="Pizzafy Logo" class="header-logo-image" />
                    </div>
                    <span class="brand-text ms-3">Pizzafy</span>
                </a>
                
                <!-- Mobile Toggle Button -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <!-- Navigation Menu -->
                <div class="collapse navbar-collapse" id="navbarNav">
                    <!-- Center Navigation -->
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">HOME</a>
                        </li>
                        <li class="nav-item">
                            @if (User.Identity!.IsAuthenticated)
                            {
                                <!-- Navigate to menu section on Index page even from other pages -->
                                <a class="nav-link menu-nav-link" href="/Index#menu-section">MENU</a>
                            }
                            else
                            {
                                <a class="nav-link" asp-area="" asp-page="/Login">MENU</a>
                            }
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/About">ABOUT</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Contact">CONTACT</a>
                        </li>
                    </ul>
                    
                    <!-- Right Side Icons -->
                    <ul class="navbar-nav position-relative">
                        @if (User.Identity!.IsAuthenticated)
                        {
                            <!-- Orders Icon -->
                            <li class="nav-item">
                                <a class="nav-link nav-icon" asp-area="" asp-page="/Orders" title="My Orders">
                                    <i class="fas fa-clipboard-list"></i>
                                </a>
                            </li>
                            
                            <!-- Shopping Cart Icon -->
                            <li class="nav-item position-relative">
                                <a class="nav-link nav-icon" asp-area="" asp-page="/Cart" title="Shopping Cart">
                                    <i class="fas fa-shopping-cart"></i>
                                    <span id="cart-count" class="position-absolute translate-middle badge rounded-pill bg-danger" style="top:8px; right:4px; display:none;">0</span>
                                </a>
                            </li>
                            
                            <!-- User Profile Dropdown -->
                            <li class="nav-item dropdown">
                                <a class="nav-link nav-icon dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="Profile">
                                    <i class="fas fa-user"></i>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li>
                                        <span class="dropdown-item-text">
                                            <strong>@User.Identity.Name</strong>
                                        </span>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Profile"><i class="fas fa-user-edit me-2"></i>My Profile</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Orders"><i class="fas fa-history me-2"></i>Order History</a></li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" href="/Admin/MenuManagement"><i class="fas fa-cog me-2"></i>Admin Panel</a></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" asp-area="" asp-page="/Logout"><i class="fas fa-sign-out-alt me-2"></i>Logout</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <!-- Login Icon for Non-Authenticated Users -->
                            <li class="nav-item">
                                <a class="nav-link nav-icon" asp-area="" asp-page="/Login" title="Login">
                                    <i class="fas fa-user"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main id="main-content" style="padding-top: 90px;">
        @RenderBody()
    </main>

    <footer class="pizzafy-footer mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <div class="footer-brand">
                        <img src="~/images/pizza-slice.svg" alt="Pizzafy Logo" class="footer-logo" />
                        <span class="ms-2">Pizzafy</span>
                    </div>
                    <p class="footer-tagline">Where every bite tastes like home</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p>&copy; 2025 Pizzafy. All rights reserved.</p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Add to cart modal -->
    <div class="modal fade add-cart-modal" id="addToCartModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content shadow-lg">
          <div class="modal-header border-0" style="background:#8c1007;color:#fff;border-top-left-radius:.5rem;border-top-right-radius:.5rem;">
            <h6 class="modal-title"><i class="fas fa-shopping-cart me-2"></i>Added to Cart</h6>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body text-center py-4">
            <div class="mx-auto mb-3 d-flex align-items-center justify-content-center" style="width:56px;height:56px;border-radius:50%;background:#e8f7ee;color:#28a745;">
              <i class="fas fa-check" style="font-size:22px;"></i>
            </div>
            <div style="font-weight:700;color:#333;">Item was added to your cart</div>
            <small class="text-muted">This will close automatically</small>
          </div>
        </div>
      </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    @if (TempData["SuccessMessage"] != null && Context.Request.Query["success"].Count > 0)
    {
        <div class="alert alert-success position-fixed top-0 end-0 m-4 fade show" style="z-index:9999; min-width:300px;">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close ms-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <script>
        async function refreshCartCount() {
            try {
                const res = await fetch('/api/cart/count');
                if (!res.ok) return;
                const data = await res.json();
                const el = document.getElementById('cart-count');
                if (el) {
                    if (data.count > 0) {
                        el.textContent = data.count;
                        el.style.display = 'inline-block';
                    } else {
                        el.style.display = 'none';
                    }
                }
            } catch { }
        }

        window.onAddedToCart = function() {
            const modalEl = document.getElementById('addToCartModal');
            if (modalEl) {
                const modal = new bootstrap.Modal(modalEl, { backdrop: true, keyboard: true });
                modal.show();
                setTimeout(() => modal.hide(), 3000);
            }
            refreshCartCount();
        }

        document.addEventListener('DOMContentLoaded', () => {
            refreshCartCount();
        });
    </script>
</body>
</html>