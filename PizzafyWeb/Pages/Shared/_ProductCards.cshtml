@using System.Text.RegularExpressions
@model IEnumerable<PizzafyWeb.Pages.PizzaProductViewModel>

@functions {
    public static string FormatSizeLabel(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return name ?? string.Empty;
        var m = Regex.Match(name, "\\((\\d+)\\s*oz\\)", RegexOptions.IgnoreCase);
        if (m.Success)
        {
            return $"{m.Groups[1].Value}oz"; // e.g., Small (8 oz) -> 8oz
        }
        return name!;
    }
}

@if (Model != null && Model.Any())
{
    foreach (var product in Model)
    {
        var isDisabled = product is { IsAvailable: false };
        <div class="col-xl-3 col-lg-4 col-md-6 mb-4">
            <div class="product-card @(isDisabled ? "disabled" : string.Empty)" data-name="@((product.ItemName ?? string.Empty).ToLower())" style="background:@(isDisabled ? "#fffbe6" : "#8c1007");border-radius:20px;color:@(isDisabled ? "#8c1007" : "white");padding:1.5rem 1rem;text-align:center;box-shadow:0 8px 25px rgba(140,16,7,0.4);height:100%;transition:all 0.3s ease;position:relative;overflow:hidden;">
                <!-- Decorative elements -->
                <div style="position:absolute;top:-30px;right:-30px;width:60px;height:60px;background:rgba(255,248,220,0.1);border-radius:50%;"></div>
                <div style="position:absolute;bottom:-20px;left:-20px;width:40px;height:40px;background:rgba(255,248,220,0.1);border-radius:50%;"></div>
                
                <div class="not-available-overlay" style="position:absolute;inset:0;background:rgba(255,255,255,0.85);display:@(isDisabled ? "flex" : "none");align-items:center;justify-content:center;z-index:3;font-weight:900;color:#8c1007;text-transform:uppercase;letter-spacing:1px;font-size:1.5rem;">
                    Not Available
                </div>
                
                <!-- Product Image -->
                <div class="product-image mb-2" style="position:relative;z-index:2;">
                    @if (!string.IsNullOrWhiteSpace(product.Image))
                    {
                        <img src="/images/products/@product.Image" alt="@product.ItemName" style="width:160px;height:160px;border-radius:50%;object-fit:cover;margin:0 auto;display:block;background:transparent;" />
                    }
                    else
                    {
                        <div style="width:160px;height:160px;border-radius:50%;background:transparent;margin:0 auto;"></div>
                    }
                </div>
                
                <!-- Product Name -->
                <h4 style="font-weight:800;font-size:1.3rem;margin-bottom:0.5rem;color:@(isDisabled ? "#8c1007" : "white");position:relative;z-index:2;">@product.ItemName</h4>
                
                <!-- Product Description -->
                <p style="color:@(isDisabled ? "#8c1007" : "#FFF8DC");font-size:0.9rem;line-height:1.3;margin-bottom:1rem;min-height:2.5rem;position:relative;z-index:2;font-weight:400;">
                    @(product.Description ?? "Delicious item made with fresh ingredients")
                </p>
                
                <!-- Price -->
                <div class="product-price" style="font-size:1.8rem;font-weight:900;margin-bottom:1rem;color:@(isDisabled ? "#8c1007" : "#FFD700");text-shadow:2px 2px 4px rgba(0,0,0,0.3);position:relative;z-index:2;">
                    &#8369;@product.Price.ToString("0.00")
                </div>
                
                <!-- Controls -->
                <div class="product-controls" style="position:relative;z-index:2;">
                    <div class="controls-row" style="display:grid;grid-template-columns:50px 1fr 50px;gap:5px;align-items:end;max-width:360px;margin:0 auto;">
                        <div class="control-group" style="text-align:left;">
                            <label style="font-weight:700;font-size:0.75rem;color:#FFD700;display:block;margin-bottom:2px;">QTY</label>
                            <select class="form-select qty-select" style="width:50px;height:44px;border-radius:8px;border:2px solid #FFF8DC;font-weight:600;text-align:center;font-size:0.85rem;padding:0 4px;margin:0;" @(isDisabled ? "disabled" : string.Empty)>
                                @for (int i = 1; i <= 10; i++)
                                {
                                    <option value="@i">@i</option>
                                }
                            </select>
                        </div>
                        <div class="control-group" style="text-align:center;">
                            <label style="font-weight:700;font-size:0.75rem;color:#FFD700;display:block;margin-bottom:2px;">SIZE</label>
                            <select class="form-select size-select" style="width:100%;height:44px;border-radius:8px;border:2px solid #FFF8DC;font-weight:600;text-align:center;font-size:0.8rem;padding:0 10px;margin:0;" @(isDisabled ? "disabled" : string.Empty)>

                                @foreach (var size in product.Sizes)
                                {
                                    var label = FormatSizeLabel(size.SizeName);
                                    var text = size.IsAvailable ? label : (label + " - Unavailable");
                                    if (size.IsAvailable)
                                    {
                                        <option value="@size.SizeId" data-price="@size.Price" data-price-id="@size.PriceId">@text</option>
                                    }
                                    else
                                    {
                                        <option value="@size.SizeId" data-price="@size.Price" data-price-id="@size.PriceId" disabled>@text</option>
                                    }
                                }
                            </select>
                        </div>
                        <button class="add-to-cart-btn" style="background:#FFF8DC;color:#8c1007;border:none;border-radius:12px;width:50px;height:44px;font-size:1.1rem;transition:all 0.3s ease;box-shadow:0 3px 10px rgba(0,0,0,0.2);font-weight:800;display:flex;align-items:center;justify-content:center;" data-product-id="@product.MenuItemId" @(isDisabled ? "disabled" : string.Empty)>

                            <i class="fas fa-shopping-cart"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}

<script>
    document.querySelectorAll('.product-card .size-select').forEach(sel => {
        if (sel.disabled) return;
        const priceEl = sel.closest('.product-card').querySelector('.product-price');
        const apply = () => {
            // select first available if current is disabled
            if (sel.options[sel.selectedIndex]?.disabled) {
                const idx = Array.from(sel.options).findIndex(o => !o.disabled);
                if (idx >= 0) sel.selectedIndex = idx;
            }
            const opt = sel.options[sel.selectedIndex];
            const p = parseFloat(opt?.dataset.price);
            if (!isNaN(p)) priceEl.textContent = `\u20B1${p.toFixed(2)}`;
        };
        sel.addEventListener('change', apply);
        apply();
    });
</script>