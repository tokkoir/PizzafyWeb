@page
@model PizzafyWeb.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_AdminLayout";
}

<div class="admin-page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="admin-page-title">
                <i class="fas fa-gauge-high me-2"></i>Dashboard
            </h1>
            <p class="admin-page-subtitle">Overview of your store</p>
        </div>
    </div>
</div>

<!-- Date Range Filter -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-calendar-alt me-2"></i>Date Range Filter</h5>
            </div>
            <div class="card-body">
                <form method="post" class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label asp-for="StartDate" class="form-label">Start Date</label>
                        <input asp-for="StartDate" class="form-control" type="date" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EndDate" class="form-label">End Date</label>
                        <input asp-for="EndDate" class="form-control" type="date" />
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-filter me-1"></i>Apply Filter
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Stock Cards -->
<div class="row g-3 mb-4">
    @{
        var categories = Model.ProductsByCategory;
        var totalProducts = categories.Sum(c => c.ProductCount);
        var stockCards = new List<dynamic> {
            new { title = "Pizza Items", count = categories.FirstOrDefault(c => c.CategoryName.Equals("Pizza", StringComparison.OrdinalIgnoreCase))?.ProductCount ?? 0, color = "primary", icon = "fas fa-pizza-slice" },
            new { title = "Sides Items", count = categories.FirstOrDefault(c => c.CategoryName.Equals("Sides", StringComparison.OrdinalIgnoreCase))?.ProductCount ?? 0, color = "warning", icon = "fas fa-utensils" },
            new { title = "Beverage Items", count = categories.FirstOrDefault(c => c.CategoryName.Equals("Beverages", StringComparison.OrdinalIgnoreCase))?.ProductCount ?? 0, color = "success", icon = "fas fa-glass-water" },
            new { title = "Total Items", count = totalProducts, color = "danger", icon = "fas fa-warehouse" }
        };
    }
    
    @foreach (var card in stockCards)
    {
        <div class="col-lg-3 col-md-6">
            <div class="stock-card stock-card-@card.color">
                <div class="stock-card-content">
                    <div class="stock-title">@card.title</div>
                    <div class="stock-number">@card.count</div>
                </div>
                <div class="stock-icon">
                    <i class="@card.icon"></i>
                </div>
                <div class="stock-bg-circle"></div>
            </div>
        </div>
    }
</div>

<!-- Sales Overview -->
<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="dashboard-section-title">
            <i class="fas fa-chart-line me-2 text-danger"></i>Sales Overview
        </h3>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-danger btn-sm" type="button" id="exportPdfBtn">
                <i class="fas fa-file-pdf me-1"></i>Export PDF
            </button>
            <button class="btn btn-danger btn-sm" type="button" id="printReportBtn">
                <i class="fas fa-print me-1"></i>Print Report
            </button>
        </div>
    </div>
    
    <div class="row g-3">
        <div class="col-lg-3 col-md-6">
            <div class="sales-card">
                <div class="sales-icon text-danger">
                    <i class="fas fa-calendar-check"></i>
                </div>
                <div class="sales-content">
                    <div class="sales-title">Selected Period Sales</div>
                    <div class="sales-amount">₱ @Model.SelectedPeriodSales.ToString("N2")</div>
                    <div class="sales-period">@Model.StartDate.ToString("MMM dd") - @Model.EndDate.ToString("MMM dd")</div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-3 col-md-6">
            <div class="sales-card">
                <div class="sales-icon text-warning">
                    <i class="fas fa-clock"></i>
                </div>
                <div class="sales-content">
                    <div class="sales-title">Sales (Last 24 Hours)</div>
                    <div class="sales-amount">₱ @Model.Sales24Hours.ToString("N2")</div>
                    <div class="sales-period">Past 24 hours</div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-3 col-md-6">
            <div class="sales-card">
                <div class="sales-icon text-purple">
                    <i class="fas fa-calendar-week"></i>
                </div>
                <div class="sales-content">
                    <div class="sales-title">This Week's Sales</div>
                    <div class="sales-amount">₱ @Model.SalesThisWeek.ToString("N2")</div>
                    <div class="sales-period">Current week</div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-3 col-md-6">
            <div class="sales-card">
                <div class="sales-icon text-success">
                    <i class="fas fa-calendar-alt"></i>
                </div>
                <div class="sales-content">
                    <div class="sales-title">This Month's Sales</div>
                    <div class="sales-amount">₱ @Model.SalesThisMonth.ToString("N2")</div>
                    <div class="sales-period">Current month</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Purchase Details -->
<div class="mb-4">
    <h3 class="dashboard-section-title mb-3">
        <i class="fas fa-shopping-cart me-2 text-danger"></i>Purchase Details
    </h3>
    
    <div class="purchase-details-container">
        <div class="purchase-header">
            <div class="purchase-title">Customer Purchases</div>
            <div class="search-container">
                <input type="text" class="form-control" placeholder="Search customer..." id="customerSearch">
            </div>
        </div>
        
        <div class="customer-section">
            <div class="customer-header">CUSTOMER NAME</div>
            
            <div class="customer-entries" id="customerList">
                @if (Model.CustomerPurchases.Any())
                {
                    var groupedCustomers = Model.CustomerPurchases.GroupBy(p => p.UserId).Take(200);
                    foreach (var group in groupedCustomers)
                    {
                        var sample = group.First();
                        <div class="customer-entry" data-user-id="@sample.UserId">
                            <i class="fas fa-user customer-icon"></i>
                            <a href="#" class="customer-link" data-user-id="@sample.UserId" data-name="@sample.CustomerName">@sample.CustomerName</a>
                        </div>
                    }
                }
                else
                {
                    <div class="no-customers">
                        <i class="fas fa-receipt fa-2x mb-2 text-muted"></i>
                        <p class="text-muted">No purchases found for the selected date range</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Customer Orders Modal -->
<div class="modal fade" id="customerOrdersModal" tabindex="-1" aria-labelledby="customerOrdersModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="customerOrdersModalLabel">
                    <i class="fas fa-user me-2"></i><span id="customerModalName"></span> - Order History
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="customerOrdersContent">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Order Details Modal -->
<div class="modal fade" id="orderDetailsModal" tabindex="-1" aria-labelledby="orderDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="orderDetailsModalLabel">
                    <i class="fas fa-receipt me-2"></i>Order Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="orderDetailsContent">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .stock-card {
            background: linear-gradient(135deg, var(--stock-color-1), var(--stock-color-2));
            border-radius: 20px;
            padding: 24px;
            color: white;
            position: relative;
            overflow: hidden;
            cursor: pointer;
            transition: transform 0.3s ease;
            height: 160px;
        }
        
        .stock-card:hover {
            transform: translateY(-5px);
        }
        
        .stock-card-primary {
            --stock-color-1: #4f7df3;
            --stock-color-2: #3b6af0;
        }
        
        .stock-card-warning {
            --stock-color-1: #f5b942;
            --stock-color-2: #f3a934;
        }
        
        .stock-card-success {
            --stock-color-1: #28c76f;
            --stock-color-2: #1fad5f;
        }
        
        .stock-card-danger {
            --stock-color-1: #ea5455;
            --stock-color-2: #e63946;
        }
        
        .stock-card-content {
            position: relative;
            z-index: 2;
        }
        
        .stock-title {
            font-size: 14px;
            opacity: 0.9;
            margin-bottom: 8px;
        }
        
        .stock-number {
            font-size: 36px;
            font-weight: 700;
            margin-bottom: 8px;
        }
        
        .stock-link {
            font-size: 12px;
            opacity: 0.8;
        }
        
        .stock-icon {
            position: absolute;
            top: 20px;
            right: 20px;
            font-size: 32px;
            opacity: 0.3;
            z-index: 1;
        }
        
        .stock-bg-circle {
            position: absolute;
            width: 120px;
            height: 120px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            top: -20px;
            right: -30px;
            z-index: 1;
        }
        
        .dashboard-section-title {
            font-size: 20px;
            font-weight: 600;
            color: #333;
        }
        
        .sales-card {
            background: white;
            border-radius: 12px;
            padding: 20px;
            border: 1px solid #f0f0f0;
            transition: box-shadow 0.3s ease;
        }
        
        .sales-card:hover {
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        }
        
        .sales-icon {
            font-size: 24px;
            margin-bottom: 12px;
        }
        
        .sales-title {
            font-size: 14px;
            color: #666;
            margin-bottom: 8px;
        }
        
        .sales-amount {
            font-size: 24px;
            font-weight: 700;
            color: #333;
            margin-bottom: 4px;
        }
        
        .sales-period {
            font-size: 12px;
            color: #999;
        }
        
        .text-purple {
            color: #9c27b0 !important;
        }
        
        .purchase-details-container {
            background: white;
            border-radius: 12px;
            border: 1px solid #f0f0f0;
            overflow: hidden;
        }
        
        .purchase-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 24px;
            border-bottom: 1px solid #f0f0f0;
        }
        
        .purchase-title {
            font-size: 16px;
            font-weight: 500;
            color: #333;
        }
        
        .search-container {
            width: 300px;
        }
        
        .search-container .form-control {
            border-radius: 8px;
            border: 1px solid #e0e0e0;
            padding: 8px 12px;
            font-size: 14px;
        }
        
        .search-container .form-control:focus {
            border-color: #4f7df3;
            box-shadow: 0 0 0 0.2rem rgba(79, 125, 243, 0.25);
        }
        
        .customer-section {
            padding: 0;
        }
        
        .customer-header {
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #999;
            padding: 16px 24px 8px 24px;
            background: #fafafa;
            border-bottom: 1px solid #f0f0f0;
        }
        
        .customer-entries {
            padding: 0;
            max-height: 300px;
            overflow-y: auto;
        }
        
        .customer-entry {
            display: flex;
            align-items: center;
            padding: 12px 24px;
            border-bottom: 1px solid #f8f9fa;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }
        
        .customer-entry:hover {
            background-color: #f8f9fa;
        }
        
        .customer-entry:last-child {
            border-bottom: none;
        }
        
        .customer-icon {
            color: #4f7df3;
            margin-right: 12px;
            font-size: 16px;
        }
        
        .customer-link {
            color: #4f7df3;
            text-decoration: none;
            font-weight: 500;
            font-size: 14px;
        }
        
        .customer-link:hover {
            text-decoration: underline;
        }
        
        .no-customers {
            text-align: center;
            padding: 40px 24px;
        }
        
        .order-list-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 12px;
            border: 1px solid #eee;
            border-radius: 8px;
            margin-bottom: 8px;
            background: #fafafa;
            cursor: pointer;
            transition: .15s;
        }
        
        .order-list-item:hover {
            background: #f0f4ff;
            border-color: #cfe2ff;
        }
        
        .order-id-badge {
            background: #4f7df3;
            color: #fff;
            border-radius: 6px;
            padding: 4px 8px;
            font-size: 11px;
            font-weight: 600;
        }
        
        .order-status {
            font-size: 11px;
            font-weight: 600;
            padding: 4px 8px;
            border-radius: 6px;
        }
        
        .status-Pending {
            background: #ffe8a1;
            color: #8c6d00;
        }
        
        .status-Preparing {
            background: #bde5ff;
            color: #004f7d;
        }
        
        .status-Ready {
            background: #d0c4ff;
            color: #4b2ca3;
        }
        
        .status-Completed {
            background: #c7f5d9;
            color: #0e6b2f;
        }
        
        .status-Cancelled {
            background: #f8d7da;
            color: #842029;
        }
        
        @@media print {
            body {
                background: #fff !important;
            }
            
            .admin-page-header,
            .purchase-header,
            #customerSearch,
            nav,
            .btn,
            .modal {
                display: none !important;
            }
            
            .stock-card,
            .sales-card {
                box-shadow: none;
                border: 1px solid #ddd;
            }
            
            .table td,
            .table th {
                padding: .4rem;
            }
            
            .print-title {
                font-size: 24px;
                font-weight: 700;
                margin-bottom: 10px;
            }
            
            .print-sub {
                font-size: 12px;
                color: #666;
                margin-bottom: 20px;
            }
            
            .print-section {
                margin-bottom: 18px;
            }
            
            .badge {
                border: 1px solid #ccc;
            }
        }

        .order-details-table{width:100%;border-collapse:collapse;table-layout:fixed}
        .order-details-table thead th{background:#f8f9fa;font-size:12px;font-weight:600;letter-spacing:.3px;border-bottom:1px solid #dee2e6;padding:8px}
        .order-details-table tbody td{padding:6px 8px;font-size:13px;border-bottom:1px solid #eee}
        .order-details-table tfoot td{padding:8px;font-size:13px;font-weight:600}
        .order-details-table th:nth-child(1){width:42%;}
        .order-details-table th:nth-child(2){width:14%;}
        .order-details-table th:nth-child(3){width:10%;text-align:center}
        .order-details-table th:nth-child(4){width:14%;text-align:right}
        .order-details-table th:nth-child(5){width:20%;text-align:right}
        .order-details-table td.size{text-align:left}
        .order-details-table td.qty{text-align:center;font-weight:600}
        .order-details-table td.price, .order-details-table td.subtotal{ text-align:right; white-space:nowrap; }
        .order-details-table tfoot tr.total-row td{background:#e6f4ec;border-top:1px solid #c9e6d4}
        .order-details-header{margin-bottom:.75rem}
        .order-meta-block{display:flex;gap:18px;flex-wrap:wrap;margin-top:.25rem}
        .order-meta-item{min-width:220px;font-size:13px;line-height:1.3}
        .order-meta-item span.label{display:inline-block;font-weight:600;color:#495057;width:70px}
        .order-status.badge{font-size:11px;font-weight:600;padding:6px 10px;margin-left:4px}
        .order-header-row{display:flex;align-items:center;justify-content:space-between}
        .order-header-row .order-id{font-weight:600;font-size:16px}
        .order-date{font-size:12px;color:#6c757d;margin-top:2px}
        @@media (max-width: 768px){
            .order-meta-item{min-width:100%;}
            .order-meta-item span.label{width:72px}
        }
    </style>
}

@section Scripts {
    <script>
        const formatPeso = v => '₱'+ Number(v).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2});
        const pagePath = window.location.pathname;

        // Ensure stale backdrops are cleaned when ALL modals are closed
        document.addEventListener('hidden.bs.modal', () => {
            // Delay a tick so Bootstrap can finish its own cleanup
            setTimeout(()=>{
                const openModals = document.querySelectorAll('.modal.show');
                if(openModals.length === 0){
                    // Remove any leftover backdrops
                    document.querySelectorAll('.modal-backdrop').forEach(b=>b.remove());
                    document.body.classList.remove('modal-open');
                    document.body.style.removeProperty('padding-right');
                }
            },30);
        });

        // Helper to show (and reuse) a modal instance safely
        function showModal(id){
            const el = document.getElementById(id);
            if(!el) return;
            let instance = bootstrap.Modal.getInstance(el);
            if(!instance){ instance = new bootstrap.Modal(el); }
            instance.show();
        }

        async function viewCustomerOrders(userId,name){
            const modalEl=document.getElementById('customerOrdersModal');
            document.getElementById('customerModalName').textContent=name;
            const body=document.getElementById('customerOrdersContent');
            body.innerHTML='<div class="text-center py-4"><div class="spinner-border text-primary"><span class="visually-hidden">Loading...</span></div></div>';
            try{
                const res=await fetch(`${pagePath}?handler=CustomerOrders&userId=${encodeURIComponent(userId)}`);
                if(!res.ok) throw 0;
                const data=await res.json();
                if(!data.orders||data.orders.length===0){
                    body.innerHTML='<div class="text-center text-muted py-4">No orders found for this customer.</div>';
                } else {
                    const list=data.orders.map(o=>`<div class='order-list-item' data-order-id='${o.orderId}'><div style='flex:1;display:flex;flex-direction:column;'><span class='order-id-badge'>#${o.orderId}</span><small class='text-muted'>${o.orderDate}</small></div><div style='text-align:right;'><div class='fw-semibold'>${formatPeso(o.totalAmount)}</div><div class='order-status status-${o.status}'>${o.status}</div></div></div>`).join('');
                    body.innerHTML=`<div style='max-height:500px;overflow-y:auto'>${list}</div>`;
                }
            }catch{ body.innerHTML='<div class="text-center text-danger py-4">Error loading orders.</div>'; }
            showModal('customerOrdersModal');
        }

        async function viewOrderDetails(orderId){
            const body=document.getElementById('orderDetailsContent');
            body.innerHTML='<div class="text-center py-4"><div class="spinner-border text-primary"><span class="visually-hidden">Loading...</span></div></div>';
            try{
                const res=await fetch(`${pagePath}?handler=OrderDetails&orderId=${encodeURIComponent(orderId)}`);
                if(!res.ok) throw 0;
                const o=await res.json();
                const rows=(o.items||[]).map(i=>`<tr><td>${i.itemName}</td><td class='size'>${i.size}</td><td class='qty'>${i.quantity}</td><td class='price'>${formatPeso(i.unitPrice)}</td><td class='subtotal'>${formatPeso(i.subtotal)}</td></tr>`).join('');
                body.innerHTML=`<div class='order-details-header'><div class='order-header-row'><div class='order-id'>Order #${o.orderId}<span class='badge order-status status-${o.status}'>${o.status}</span></div></div><div class='order-date'>${o.orderDate}</div><div class='order-meta-block'><div class='order-meta-item'><span class='label'>Customer:</span> ${o.customerName}</div><div class='order-meta-item'><span class='label'>Phone:</span> ${o.customerPhone||'N/A'}</div><div class='order-meta-item'><span class='label'>Payment:</span> ${o.paymentMethod}</div><div class='order-meta-item'><span class='label'>Address:</span> ${o.deliveryAddress||'N/A'}</div></div></div><table class='order-details-table'><thead><tr><th>Item</th><th>Size</th><th>Qty</th><th>Unit Price</th><th>Subtotal</th></tr></thead><tbody>${rows}</tbody><tfoot><tr><td colspan='4'>Delivery Fee</td><td class='subtotal'>${formatPeso(o.deliveryFee)}</td></tr><tr class='total-row'><td colspan='4'>Total</td><td class='subtotal'>${formatPeso(o.totalAmount)}</td></tr></tfoot></table>`;
            }catch{ body.innerHTML='<div class="text-center text-danger py-4">Error loading order details.</div>'; }
            showModal('orderDetailsModal');
        }

        // Delegated click handling
        document.addEventListener('click',e=>{
            const link=e.target.closest('a.customer-link');
            if(link){ e.preventDefault(); viewCustomerOrders(link.dataset.userId, link.dataset.name); return; }
            const order=e.target.closest('.order-list-item');
            if(order){ viewOrderDetails(order.dataset.orderId); }
        });

        // Search filter
        const searchInput=document.getElementById('customerSearch');
        searchInput?.addEventListener('input',()=>{
            const term=searchInput.value.toLowerCase();
            document.querySelectorAll('#customerList .customer-entry').forEach(row=>{
                const name=row.querySelector('.customer-link')?.textContent.toLowerCase()||'';
                row.style.display=name.includes(term)?'':'none';
            });
        });
    </script>
}
