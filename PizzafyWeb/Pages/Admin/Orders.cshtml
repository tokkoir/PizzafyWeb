@page
@model PizzafyWeb.Pages.Admin.OrdersModel
@{
    ViewData["Title"] = "Order Management";
    Layout = "_AdminLayout";
}

<!-- Page Header -->
<div class="admin-page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="admin-page-title">
                <i class="fas fa-truck me-2"></i>Order Management
            </h1>
            <p class="admin-page-subtitle">Manage customer orders and update status</p>
        </div>
        <div class="admin-stats-mini">
            <div class="stat-mini">
                <span class="stat-value">@Model.TotalOrders</span>
                <span class="stat-label">Total Orders</span>
            </div>
            <div class="stat-mini">
                <span class="stat-value">&#8369;@Model.TotalRevenue.ToString("0.00")</span>
                <span class="stat-label">Total Revenue</span>
            </div>
        </div>
    </div>
</div>

<!-- Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Order Statistics Cards -->
<div class="row mb-4">
    <div class="col-lg-3 col-md-6 mb-3">
        <div class="admin-stat-card pending">
            <div class="stat-icon">
                <i class="fas fa-clock"></i>
            </div>
            <div class="stat-content">
                <h3>@Model.PendingOrders</h3>
                <p>Pending</p>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3">
        <div class="admin-stat-card preparing">
            <div class="stat-icon">
                <i class="fas fa-utensils"></i>
            </div>
            <div class="stat-content">
                <h3>@Model.PreparingOrders</h3>
                <p>Preparing</p>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3">
        <div class="admin-stat-card ready">
            <div class="stat-icon">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="stat-content">
                <h3>@Model.ReadyOrders</h3>
                <p>Ready</p>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3">
        <div class="admin-stat-card completed">
            <div class="stat-icon">
                <i class="fas fa-trophy"></i>
            </div>
            <div class="stat-content">
                <h3>@Model.CompletedOrders</h3>
                <p>Completed</p>
            </div>
        </div>
    </div>
</div>

<!-- Filters and Search -->
<div class="admin-content-card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Filter by Status</label>
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="all" selected="@(Model.StatusFilter == "all")">All Orders</option>
                    <option value="pending" selected="@(Model.StatusFilter == "pending")">Pending</option>
                    <option value="preparing" selected="@(Model.StatusFilter == "preparing")">Preparing</option>
                    <option value="ready" selected="@(Model.StatusFilter == "ready")">Ready</option>
                    <option value="completed" selected="@(Model.StatusFilter == "completed")">Completed</option>
                    <option value="cancelled" selected="@(Model.StatusFilter == "cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Search Orders</label>
                <div class="input-group">
                    <input type="text" name="search" class="form-control" 
                           placeholder="Search by Order ID, Customer Name, Phone..." 
                           value="@Model.SearchTerm" />
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label">&nbsp;</label>
                <div class="d-grid">
                    <a href="/Admin/Orders" class="btn btn-outline-secondary">
                        <i class="fas fa-refresh me-1"></i>Clear Filters
                    </a>
                </div>
            </div>
            <!-- Hidden field to maintain current page -->
            <input type="hidden" name="page" value="1" />
        </form>
    </div>
</div>

<!-- Orders Table -->
<div class="admin-content-card">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="fas fa-list me-2"></i>Orders
                @if (!string.IsNullOrEmpty(Model.StatusFilter) && Model.StatusFilter != "all")
                {
                    <span class="badge bg-primary ms-2">@Model.StatusFilter.ToUpper()</span>
                }
            </h5>
            <span class="text-muted">Page @Model.CurrentPage of @Model.TotalPages</span>
        </div>
    </div>
    <div class="card-body p-0">
        @if (!Model.Orders.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-search fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">No orders found</h5>
                <p class="text-muted">No orders match your current filters.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Customer</th>
                            <th>Items</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Order Date</th>
                            <th>Paid</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.Orders)
                        {
                            var current = order.StatusName;
                            string? allowedNext = current switch { "Pending" => "Preparing", "Preparing" => "Ready", "Ready" => "Completed", _ => null };
                            bool isTerminal = allowedNext == null;

                            <tr>
                                <td>
                                    <div>
                                        <strong>@order.CustomerName</strong>
                                        <br>
                                        <small class="text-muted">
                                            <i class="fas fa-phone me-1"></i>@order.CustomerPhone
                                        </small>
                                        @if (!string.IsNullOrEmpty(order.DeliveryAddress) && order.DeliveryAddress != "N/A")
                                        {
                                            <br>
                                            <small class="text-muted">
                                                <i class="fas fa-map-marker-alt me-1"></i>
                                                @(order.DeliveryAddress.Length > 30 ? order.DeliveryAddress.Substring(0, 30) + "..." : order.DeliveryAddress)
                                            </small>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-info">@order.ItemCount items</span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary ms-1" 
                                            data-bs-toggle="modal" data-bs-target="#orderModal@(order.OrderId)">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </td>
                                <td>
                                    <strong>&#8369;@order.TotalAmount.ToString("0.00")</strong>
                                    @if (order.DeliveryFee > 0)
                                    {
                                        <br>
                                        <small class="text-muted">incl. &#8369;@order.DeliveryFee.ToString("0.00") delivery</small>
                                    }
                                </td>
                                <td>
                                    <span class="badge @GetStatusBadgeClass(order.StatusName)">
                                        @order.StatusName
                                    </span>
                                </td>
                                <td>
                                    @PizzafyWeb.Utils.TimeUtils.FormatPH(order.OrderDate, "MMM dd, yyyy 'at' hh:mm tt")
                                    <br>
                                    <small class="text-muted">@order.TimeAgo</small>
                                </td>
                                <td>
                                    @if (order.IsPaid)
                                    {
                                        <span class="badge bg-success">Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Unpaid</span>
                                    }
                                </td>
                                <td>
                                    <form method="post" asp-page-handler="UpdateStatus" class="d-inline" onsubmit="return lockStatusUpdates(this)">
                                        <input type="hidden" name="orderId" value="@order.OrderId" />
                                        <input type="hidden" name="status" value="@Model.StatusFilter" />
                                        <input type="hidden" name="search" value="@Model.SearchTerm" />
                                        <input type="hidden" name="page" value="@Model.CurrentPage" />
                                        <input type="hidden" name="lastUpdateTicks" value="@order.LastUpdate.Ticks" />
                                        
                                        <select name="statusId" class="form-select form-select-sm" 
                                                onchange="this.form.submit()" 
                                                style="width: 160px;" disabled="@(isTerminal ? "disabled" : null)">
                                            <option value="@order.StatusId" selected>@order.StatusName</option>
                                            @if (!isTerminal && allowedNext != null)
                                            {
                                                var next = Model.AvailableStatuses.First(s => s.StatusName == allowedNext);
                                                <option value="@next.StatusId">@next.StatusName</option>
                                            }
                                        </select>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center">
            <!-- Previous Page -->
            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                <a class="page-link" href="?status=@Model.StatusFilter&search=@Model.SearchTerm&page=@(Model.CurrentPage - 1)">
                    <i class="fas fa-chevron-left"></i>
                </a>
            </li>

            <!-- Page Numbers -->
            @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="?status=@Model.StatusFilter&search=@Model.SearchTerm&page=@i">@i</a>
                </li>
            }

            <!-- Next Page -->
            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="?status=@Model.StatusFilter&search=@Model.SearchTerm&page=@(Model.CurrentPage + 1)">
                    <i class="fas fa-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}

<!-- Order Details Modals -->
@foreach (var order in Model.Orders)
{
    <!-- Order Details Modal -->
    <div class="modal fade" id="orderModal@(order.OrderId)" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-receipt me-2"></i>Order #@order.OrderId Details
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Customer Info -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6><i class="fas fa-user me-2"></i>Customer Information</h6>
                            <p class="mb-1"><strong>Name:</strong> @order.CustomerName</p>
                            <p class="mb-1"><strong>Phone:</strong> @order.CustomerPhone</p>
                            <p class="mb-0"><strong>Address:</strong> @order.DeliveryAddress</p>
                        </div>
                        <div class="col-md-6">
                            <h6><i class="fas fa-info-circle me-2"></i>Order Information</h6>
                            <p class="mb-1"><strong>Date:</strong> @PizzafyWeb.Utils.TimeUtils.FormatPH(order.OrderDate, "MMM dd, yyyy 'at' hh:mm tt")</p>
                            <p class="mb-1"><strong>Status:</strong> 
                                <span class="badge @GetStatusBadgeClass(order.StatusName)">@order.StatusName</span>
                            </p>
                            <p class="mb-1"><strong>Payment Method:</strong> @order.PaymentMethod @if(order.IsPaid){<span class="badge bg-success ms-2">Paid</span>}</p>
                            <p class="mb-0"><strong>Total:</strong> <span class="text-success">&#8369;@order.TotalAmount.ToString("0.00")</span></p>
                        </div>
                    </div>

                    <!-- Order Items -->
                    <h6><i class="fas fa-shopping-cart me-2"></i>Order Items</h6>
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th>Size</th>
                                    <th>Qty</th>
                                    <th>Unit Price</th>
                                    <th>Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in order.Items)
                                {
                                    <tr>
                                        <td>@item.ItemName</td>
                                        <td>@item.SizeName</td>
                                        <td>@item.Quantity</td>
                                        <td>&#8369;@item.UnitPrice.ToString("0.00")</td>
                                        <td>&#8369;@item.Subtotal.ToString("0.00")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4"><strong>Subtotal:</strong></td>
                                    <td><strong>&#8369;@((order.TotalAmount - order.DeliveryFee).ToString("0.00"))</strong></td>
                                </tr>
                                @if (order.DeliveryFee > 0)
                                {
                                    <tr>
                                        <td colspan="4"><strong>Delivery Fee:</strong></td>
                                        <td><strong>&#8369;@order.DeliveryFee.ToString("0.00")</strong></td>
                                    </tr>
                                }
                                <tr class="table-success">
                                    <td colspan="4"><strong>Total:</strong></td>
                                    <td><strong>&#8369;@order.TotalAmount.ToString("0.00")</strong></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Prevent multiple concurrent updates across the page
        let statusUpdateLocked = false;
        function lockStatusUpdates(form) {
            if (statusUpdateLocked) return false;
            statusUpdateLocked = true;
            // Disable all selects to prevent multi-change
            document.querySelectorAll('select[name="statusId"]').forEach(s => s.disabled = true);
            // Disable submit buttons as well
            form.querySelectorAll('button,select,input').forEach(el => el.setAttribute('disabled','disabled'));
            return true;
        }
    </script>
}

@section Styles {
    <style>
        .admin-stats-mini{display:flex;gap:20px}
        .stat-mini{text-align:center}
        .stat-mini .stat-value{display:block;font-size:1.2rem;font-weight:700;color:#8c1007}
        .stat-mini .stat-label{font-size:.8rem;color:#666}
    </style>
}

@functions {
    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Pending" => "bg-warning text-dark",
            "Preparing" => "bg-info text-white",
            "Ready" => "bg-primary text-white",
            "Completed" => "bg-success text-white",
            "Cancelled" => "bg-danger text-white",
            _ => "bg-secondary text-white"
        };
    }
}