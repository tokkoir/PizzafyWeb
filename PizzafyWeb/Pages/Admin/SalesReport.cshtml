@page
@model PizzafyWeb.Pages.Admin.SalesReportModel
@{
    ViewData["Title"] = "Sales Report";
    Layout = "_AdminLayout";
    string Peso(decimal v) => "\u20B1" + v.ToString("N2");
}

<!-- Page Header (Orders style but without stats) -->
<div class="admin-page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="admin-page-title"><i class="fas fa-chart-line me-2"></i>Sales Report</h1>
            <p class="admin-page-subtitle">Detailed sales metrics and trends</p>
            <div class="text-muted small"><i class="fas fa-calendar-day me-1"></i>@Model.StartDate.ToString("MMM dd, yyyy") to @Model.EndDate.ToString("MMM dd, yyyy")</div>
        </div>
    </div>
</div>

<!-- Unified horizontal filter bar -->
<div class="sr-filter-bar mb-4">
    <form method="get" class="d-flex flex-wrap align-items-center gap-2 w-100">
        <button name="range" value="today" type="submit" class="sr-quick-btn @(Model.SelectedRange=="today"?"active":"")">Today</button>
        <button name="range" value="week" type="submit" class="sr-quick-btn @(Model.SelectedRange=="week"?"active":"")">This Week</button>
        <button name="range" value="month" type="submit" class="sr-quick-btn @(Model.SelectedRange=="month"?"active":"")">This Month</button>
        <div class="d-flex align-items-center gap-1 ms-2">
            <input type="date" name="start" class="form-control form-control-sm" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
            <span class="text-muted small">to</span>
            <input type="date" name="end" class="form-control form-control-sm" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
        </div>
        <button class="btn btn-sm btn-danger px-3 ms-2">Apply</button>
        <div class="ms-auto d-flex gap-2">
            <button type="button" class="btn btn-sm btn-dark px-3" id="printSalesReportBtn"><i class="fas fa-print me-1"></i>Print Report</button>
            <button type="button" class="btn btn-sm btn-outline-dark px-3" id="exportSalesReportBtn"><i class="fas fa-file-pdf me-1"></i>Export PDF</button>
        </div>
    </form>
</div>

<div class="sr-container">
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="sr-metric shadow-sm border-top border-danger">
                <div class="sr-m-icon bg-danger-subtle text-danger"><i class="fas fa-coins"></i></div>
                <div class="sr-m-label">Total Sales</div>
                <div class="sr-m-value">@Peso(Model.TotalSales)</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="sr-metric shadow-sm border-top border-primary">
                <div class="sr-m-icon bg-primary-subtle text-primary"><i class="fas fa-receipt"></i></div>
                <div class="sr-m-label">Orders</div>
                <div class="sr-m-value">@Model.OrdersCount</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="sr-metric shadow-sm border-top border-success">
                <div class="sr-m-icon bg-success-subtle text-success"><i class="fas fa-calculator"></i></div>
                <div class="sr-m-label">Avg. Order Value</div>
                <div class="sr-m-value">@Peso(Model.AvgOrderValue)</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="sr-metric shadow-sm border-top border-purple">
                <div class="sr-m-icon bg-purple-subtle text-purple"><i class="fas fa-users"></i></div>
                <div class="sr-m-label">Customers</div>
                <div class="sr-m-value">@Model.CustomersCount</div>
            </div>
        </div>
    </div>

    <div class="card mb-4 sr-trend-card">
        <div class="card-header bg-white fw-semibold">Sales Trend</div>
        <div class="card-body p-3">
            <canvas id="salesTrendChart" height="130"></canvas>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header bg-white fw-semibold">Top Selling Products</div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0 align-middle sr-table">
                        <thead>
                            <tr><th style="width:50px">#</th><th>Product</th><th class="text-end">Qty Sold</th><th class="text-end">Revenue</th></tr>
                        </thead>
                        <tbody>
                            @if(Model.TopProducts.Any()){
                                var idx=1;
                                foreach(var p in Model.TopProducts){
                                    <tr>
                                        <td><span class="sr-rank">@idx</span></td>
                                        <td>@p.ProductName</td>
                                        <td class="text-end">@p.QtySold</td>
                                        <td class="text-end">@Peso(p.Revenue)</td>
                                    </tr>
                                    idx++;
                                }
                            } else { <tr><td colspan="4" class="text-center text-muted py-4">No product data</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header bg-white fw-semibold">Customer Purchases</div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0 align-middle sr-table">
                        <thead>
                            <tr><th>Customer</th><th class="text-end">Orders</th><th class="text-end">Total Spent</th></tr>
                        </thead>
                        <tbody>
                            @if(Model.CustomerSpends.Any()){
                                foreach(var c in Model.CustomerSpends){
                                    <tr>
                                        <td><div class="sr-avatar">@c.CustomerName.Substring(0,1).ToUpper()</div>@c.CustomerName</td>
                                        <td class="text-end">@c.Orders</td>
                                        <td class="text-end">@Peso(c.TotalSpent)</td>
                                    </tr>
                                }
                            } else { <tr><td colspan="3" class="text-center text-muted py-4">No customer data</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .sr-filter-bar{background:#fff;border:1px solid #e9ecef;border-radius:14px;padding:14px 18px;}
        .sr-filter-bar form{width:100%}
        .sr-filter-bar .form-control-sm{min-width:140px}
        .sr-filter-bar .btn{height:34px}
        .sr-container{max-width:1400px;margin:0 auto;padding-bottom:40px}
        .sr-quick-btn{background:#fff;border:1px solid #d9dee3;border-radius:8px;padding:6px 14px;font-size:13px;font-weight:600;cursor:pointer;transition:.2s}
        .sr-quick-btn.active, .sr-quick-btn:hover{background:#0d6efd;color:#fff;border-color:#0d6efd}
        .sr-metric{background:#fff;border-radius:14px;padding:18px 18px 14px;position:relative}
        .sr-m-icon{width:38px;height:38px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:18px;margin-bottom:8px}
        .bg-danger-subtle{background:rgba(220,53,69,.12)}
        .bg-primary-subtle{background:rgba(13,110,253,.12)}
        .bg-success-subtle{background:rgba(25,135,84,.12)}
        .bg-purple-subtle{background:rgba(111,66,193,.12)}
        .text-purple{color:#6f42c1!important}
        .sr-m-label{font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:600;color:#6c757d;margin-bottom:2px}
        .sr-m-value{font-size:24px;font-weight:700;color:#212529}
        .sr-table thead th{font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:#6c757d;font-weight:600;background:#f8f9fa}
        .sr-table tbody td{font-size:13px}
        .sr-table td.text-end, .sr-table th.text-end{text-align:right!important}
        .sr-rank{display:inline-block;width:26px;height:26px;line-height:26px;text-align:center;background:#f8d7da;color:#dc3545;font-weight:600;border-radius:50%;font-size:12px}
        .sr-avatar{display:inline-flex;width:28px;height:28px;border-radius:50%;background:#e7f1ff;color:#0d6efd;font-weight:600;align-items:center;justify-content:center;margin-right:8px;font-size:13px}

        /* Print-specific alignment fixes */
        @@media print {
            html, body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            nav, .sr-filter-bar, .btn, #printSalesReportBtn, #exportSalesReportBtn { display:none !important; }
            .admin-page-header { margin-bottom: 8px; }
            .sr-container { max-width: none; width: 100%; padding: 0 8px; }
            .row { gap: 10px !important; }
            .col-md-3 { flex: 0 0 24%; max-width: 24%; }
            .col-lg-6 { flex: 0 0 49%; max-width: 49%; }
            .card, .sr-metric { box-shadow: none !important; border: 1px solid #ddd; page-break-inside: avoid; break-inside: avoid; }
            table { page-break-inside: auto; }
            thead { display: table-header-group; }
            tr { page-break-inside: avoid; break-inside: avoid; }
            .sr-trend-card canvas { width: 100% !important; height: auto !important; }
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script>
        const dailySalesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailySales, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
        const reportData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
            startDate = Model.StartDate.ToString("yyyy-MM-dd"),
            endDate = Model.EndDate.ToString("yyyy-MM-dd"),
            totalSales = Model.TotalSales,
            ordersCount = Model.OrdersCount,
            avgOrderValue = Model.AvgOrderValue,
            customersCount = Model.CustomersCount,
            topProducts = Model.TopProducts,
            customerSpends = Model.CustomerSpends
        }, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));

        let salesChart;
        function pesoFmt(v){return '\u20B1'+ Number(v).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2});}
        function buildTrend(){
            const ctx=document.getElementById('salesTrendChart');
            if(!ctx) return;
            const labels=dailySalesData.map(p=>p.dateLabel);
            const data=dailySalesData.map(p=>p.amount);
            const max=Math.max(...data,0);
            const step = max <= 1000 ? 200 : Math.ceil(max/8/100)*100;
            const suggestedMax = Math.ceil(max/step)*step + step;
            salesChart = new Chart(ctx,{
                type:'line',
                data:{labels,datasets:[{label:'Daily Sales',data,borderColor:'#dc3545',backgroundColor:'rgba(220,53,69,.08)',fill:'origin',tension:.35,borderWidth:2,pointRadius:5,pointHoverRadius:6,pointBorderColor:'#dc3545',pointBackgroundColor:'#fff'}]},
                options:{
                    plugins:{
                        legend:{display:true,labels:{boxWidth:18,usePointStyle:false}},
                        tooltip:{callbacks:{label:(ctx)=>pesoFmt(ctx.parsed.y)}}
                    },
                    interaction:{mode:'index',intersect:false},
                    scales:{
                        y:{beginAtZero:true,suggestedMax:suggestedMax,ticks:{stepSize:step,callback:(value)=>pesoFmt(value)},grid:{color:'rgba(0,0,0,0.05)'}},
                        x:{grid:{display:false},ticks:{autoSkip:true,maxTicksLimit:10}}
                    },
                    elements:{line:{borderJoinStyle:'round'}}
                }
            });
        }

        function generatePrintHTML(chartImg){
            const d = reportData;
            const fmt = (v)=>'\u20B1'+ Number(v).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2});
            const topProductsRows = (d.topProducts||[]).map((p,i)=>'<tr>'+
                    '<td style="width:48px;text-align:center">'+(i+1)+'</td>'+
                    '<td>'+p.productName+'</td>'+
                    '<td style="text-align:right">'+p.qtySold+'</td>'+
                    '<td style="text-align:right">'+fmt(p.revenue)+'</td>'+
                '</tr>').join('');
            const customerRows = (d.customerSpends||[]).map((c)=>'<tr>'+
                    '<td>'+c.customerName+'</td>'+
                    '<td style="text-align:right">'+c.orders+'</td>'+
                    '<td style="text-align:right">'+fmt(c.totalSpent)+'</td>'+
                '</tr>').join('');
            const labels = dailySalesData.map(p=>p.dateLabel).join(', ');
            const values = dailySalesData.map(p=>fmt(p.amount)).join(', ');

            return `<!doctype html>
<html>
<head>
<meta charset="utf-8"/>
<title>Sales Report (${d.startDate} to ${d.endDate})</title>
<style>
    body{font-family:Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#212529;margin:24px}
    h1{font-size:22px;margin:0 0 4px 0}
    .muted{color:#6c757d}
    .header{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
    .brand{font-weight:800;letter-spacing:.5px}
    .range{font-size:12px}
    .metrics{display:flex;gap:10px;flex-wrap:wrap;margin:14px 0 18px}
    .metric{flex:1 1 180px;border:1px solid #dee2e6;border-radius:10px;padding:10px 12px}
    .metric .label{font-size:11px;color:#6c757d;text-transform:uppercase;letter-spacing:.5px;margin-bottom:2px}
    .metric .value{font-size:18px;font-weight:700}
    .card{border:1px solid #dee2e6;border-radius:10px;margin:12px 0 18px}
    .card .title{padding:10px 12px;font-weight:600;border-bottom:1px solid #eee;background:#fafbfc}
    .card .body{padding:12px}
    .row{display:flex;gap:16px;page-break-inside:avoid}
    .col{flex:1}
    table{width:100%;border-collapse:collapse;font-size:12px}
    thead th{background:#f1f3f5;text-transform:uppercase;font-size:10px;color:#6c757d;letter-spacing:.5px}
    th,td{padding:8px;border-bottom:1px solid #eee}
    tfoot td{font-weight:700}
    .small{font-size:11px}
    @@media print{ .no-print{display:none} thead{display:table-header-group} }
</style>
</head>
<body>
    <div class="header">
        <div>
            <div class="brand">Sales Report</div>
            <div class="range muted">${new Date(d.startDate).toLocaleDateString()} to ${new Date(d.endDate).toLocaleDateString()}</div>
        </div>
        <div class="small muted">Generated: ${new Date().toLocaleString()}</div>
    </div>

    <section class="metrics">
        <div class="metric"><div class="label">Total Sales</div><div class="value">${fmt(d.totalSales)}</div></div>
        <div class="metric"><div class="label">Orders</div><div class="value">${d.ordersCount}</div></div>
        <div class="metric"><div class="label">Avg. Order Value</div><div class="value">${fmt(d.avgOrderValue)}</div></div>
        <div class="metric"><div class="label">Customers</div><div class="value">${d.customersCount}</div></div>
    </section>

    <section class="card">
        <div class="title">Sales Trend</div>
        <div class="body">
            ${chartImg ? '<img src="'+chartImg+'" alt="Sales Trend" style="width:100%;max-height:320px;object-fit:contain"/>' : '<div class="small muted">Chart unavailable.</div>'}
            <div class="small muted" style="margin-top:8px">Labels: ${labels}</div>
            <div class="small muted">Values: ${values}</div>
        </div>
    </section>

    <div class="row">
        <section class="card col">
            <div class="title">Top Selling Products</div>
            <div class="body">
                <table>
                    <thead><tr><th style="width:50px">#</th><th>Product</th><th style="text-align:right">Qty</th><th style="text-align:right">Revenue</th></tr></thead>
                    <tbody>${topProductsRows || '<tr><td colspan="4" class="small muted" style="text-align:center;padding:14px">No data</td></tr>'}</tbody>
                </table>
            </div>
        </section>
        <section class="card col">
            <div class="title">Customer Purchases</div>
            <div class="body">
                <table>
                    <thead><tr><th>Customer</th><th style="text-align:right">Orders</th><th style="text-align:right">Total Spent</th></tr></thead>
                    <tbody>${customerRows || '<tr><td colspan="3" class="small muted" style="text-align:center;padding:14px">No data</td></tr>'}</tbody>
                </table>
            </div>
        </section>
    </div>
</body>
</html>`;
        }

        document.addEventListener('DOMContentLoaded', () => {
            buildTrend();
            const printBtn = document.getElementById('printSalesReportBtn');
            const exportBtn = document.getElementById('exportSalesReportBtn');

            if (printBtn) printBtn.addEventListener('click', () => {
                let img = null;
                try { if (salesChart) { img = salesChart.toBase64Image(); } } catch (_) {}
                const html = generatePrintHTML(img);
                const w = window.open('', '_blank');
                if (!w) { window.print(); return; }
                w.document.open();
                w.document.write(html);
                w.document.close();
                w.focus();
                setTimeout(()=>{ w.print(); w.close(); }, 200);
            });

            if (exportBtn) exportBtn.addEventListener('click', async () => {
                let img = null;
                try { if (salesChart) { img = salesChart.toBase64Image(); } } catch (_) {}
                const full = generatePrintHTML(img);
                let styles = '', body = full;
                try {
                    const s1 = full.indexOf('<style>');
                    const s2 = full.indexOf('</style>');
                    const b1 = full.indexOf('<body>');
                    const b2 = full.indexOf('</body>');
                    if (s1 >= 0 && s2 > s1) styles = full.substring(s1 + 7, s2);
                    if (b1 >= 0 && b2 > b1) body = full.substring(b1 + 6, b2);
                } catch(e){}
                const container = document.createElement('div');
                container.style.padding = '0';
                container.innerHTML = '<style>' + styles + '</style>' + body;
                document.body.appendChild(container);

                const opt = {
                    margin:       10,
                    filename:     `Sales_Report_${reportData.startDate}_to_${reportData.endDate}.pdf`,
                    image:        { type: 'jpeg', quality: 0.98 },
                    html2canvas:  { scale: 2, useCORS: true, scrollY: 0 },
                    jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' },
                    pagebreak:    { mode: ['css', 'legacy'] }
                };

                await html2pdf().set(opt).from(container).save();
                container.remove();
            });
        });
    </script>
}
